1. Import

# argparse is built-in - no install needed!
import argparse
---------------------------------------------------------------------------------------------------------------------------------------------
2. Basic Setup

import argparse

# Create parser
parser = argparse.ArgumentParser(
    description='My Deployment Tool'
)

# Add argument
parser.add_argument('--env', help='Environment to deploy to')

# Parse arguments
args = parser.parse_args()

# Use argument
print(f"Deploying to: {args.env}")

Run:

python deploy.py --env production
# Output: Deploying to: production
