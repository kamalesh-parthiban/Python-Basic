11. Subcommands

import argparse

parser = argparse.ArgumentParser(description='DevOps CLI Tool')

# Create subcommands
subparsers = parser.add_subparsers(dest='command')

# deploy subcommand
deploy_parser = subparsers.add_parser('deploy', help='Deploy app')
deploy_parser.add_argument('--env', required=True)
deploy_parser.add_argument('--version', required=True)

# rollback subcommand
rollback_parser = subparsers.add_parser('rollback', help='Rollback app')
rollback_parser.add_argument('--env', required=True)
rollback_parser.add_argument('--version', required=True)

# status subcommand
status_parser = subparsers.add_parser('status', help='Check status')
status_parser.add_argument('--env', required=True)

args = parser.parse_args()

# Handle subcommands
if args.command == 'deploy':
    print(f"Deploying {args.version} to {args.env}")

elif args.command == 'rollback':
    print(f"Rolling back to {args.version} in {args.env}")

elif args.command == 'status':
    print(f"Checking status of {args.env}")

Run:

# Deploy
python tool.py deploy --env production --version v2.0

# Rollback
python tool.py rollback --env production --version v1.0

# Status
python tool.py status --env production

# Help
python tool.py --help
python tool.py deploy --help

12. Real DevOps Use Cases
✅ Deployment CLI Tool

import argparse
import logging
import sys

def deploy(args):
    logging.info(f"Deploying to {args.env}...")
    logging.info(f"Version: {args.version}")
    logging.info(f"Replicas: {args.replicas}")

    if args.debug:
        logging.debug("Debug mode enabled!")

    # deployment logic here
    print(f"Deployed {args.version} to {args.env}! ✅")

def main():
    parser = argparse.ArgumentParser(
        description='Production Deployment Tool'
    )

    parser.add_argument(
        '-e', '--env',
        required=True,
        choices=['production', 'staging', 'development'],
        help='Target environment'
    )

    parser.add_argument(
        '-v', '--version',
        required=True,
        help='Version to deploy (e.g. v2.0)'
    )

    parser.add_argument(
        '-r', '--replicas',
        type=int,
        default=3,
        help='Number of replicas (default: 3)'
    )

    parser.add_argument(
        '--debug',
        action='store_true',
        help='Enable debug mode'
    )

    parser.add_argument(
        '--dry-run',
        action='store_true',
        help='Simulate without deploying'
    )

    args = parser.parse_args()

    # Setup logging
    level = logging.DEBUG if args.debug else logging.INFO
    logging.basicConfig(level=level)

    # Dry run check
    if args.dry_run:
        print(f"DRY RUN: Would deploy {args.version} to {args.env}")
        sys.exit(0)

    deploy(args)

if __name__ == '__main__':
    main()

Run:

python deploy.py -e production -v v2.0 -r 5 --debug
python deploy.py -e staging -v v2.0 --dry-run
python deploy.py --help

✅ Backup CLI Tool

import argparse

parser = argparse.ArgumentParser(
    description='Database Backup Tool'
)

parser.add_argument('--host',     required=True, help='DB host')
parser.add_argument('--port',     type=int, default=5432)
parser.add_argument('--database', required=True, help='DB name')
parser.add_argument('--output',   default='/tmp/backup', help='Output path')
parser.add_argument(
    '--compress',
    action='store_true',
    help='Compress backup'
)
parser.add_argument(
    '--format',
    choices=['sql', 'csv', 'json'],
    default='sql',
    help='Backup format'
)

args = parser.parse_args()

print(f"Backing up {args.database} from {args.host}:{args.port}")
print(f"Output: {args.output}")
print(f"Format: {args.format}")
print(f"Compress: {args.compress}")

Run:

python backup.py \
  --host localhost \
  --database mydb \
  --output /backups \
  --format sql \
  --compress
