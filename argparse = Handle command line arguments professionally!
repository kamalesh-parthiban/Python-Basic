7. Choices – Limit Valid Values

import argparse

parser = argparse.ArgumentParser()

# Only allow specific values
parser.add_argument(
    '--env',
    choices=['production', 'staging', 'development'],
    required=True,
    help='Target environment'
)

parser.add_argument(
    '--log-level',
    choices=['DEBUG', 'INFO', 'WARNING', 'ERROR'],
    default='INFO',
    help='Log level'
)

args = parser.parse_args()
print(f"Environment: {args.env}")

Run:

# Invalid choice
python deploy.py --env testing
# Error: invalid choice: 'testing'
# choose from 'production', 'staging', 'development'

# Valid choice
python deploy.py --env production
# Works!
