10. Multiple Values

import argparse

parser = argparse.ArgumentParser()

# Accept multiple values
parser.add_argument(
    '--servers',
    nargs='+',          # One or more values
    help='Server IPs'
)

parser.add_argument(
    '--ports',
    nargs='*',          # Zero or more values
    type=int,
    help='Port numbers'
)

parser.add_argument(
    '--replicas',
    nargs=3,            # Exactly 3 values
    type=int,
    help='Replica counts'
)

args = parser.parse_args()
print(args.servers)    # ['192.168.1.1', '192.168.1.2']
print(args.ports)      # [8080, 9090]
print(args.replicas)   # [3, 3, 3]

Run:

python deploy.py \
  --servers 192.168.1.1 192.168.1.2 \
  --ports 8080 9090 \
  --replicas 3 3 3
