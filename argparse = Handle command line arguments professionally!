4. Required Arguments

import argparse

parser = argparse.ArgumentParser()

# Required argument
parser.add_argument(
    '--env',
    required=True,         # Must provide this!
    help='Environment (production/staging)'
)

# Optional argument
parser.add_argument(
    '--port',
    required=False,        # Optional
    help='Port number'
)

args = parser.parse_args()
print(args.env)

Run:

# Without required argument
python deploy.py
# Error: the following arguments are required: --env

# With required argument
python deploy.py --env production
# Works!
