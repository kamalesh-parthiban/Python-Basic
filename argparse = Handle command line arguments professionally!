6. Argument Types

import argparse

parser = argparse.ArgumentParser()

# String (default)
parser.add_argument('--env',      type=str,   help='Environment')

# Integer
parser.add_argument('--port',     type=int,   help='Port number')

# Float
parser.add_argument('--timeout',  type=float, help='Timeout seconds')

# Boolean flag
parser.add_argument('--debug',    action='store_true', help='Debug mode')
parser.add_argument('--no-cache', action='store_true', help='No cache')

args = parser.parse_args()

print(args.env)       # string
print(args.port)      # integer
print(args.timeout)   # float
print(args.debug)     # True or False

Run:

python deploy.py --env production --port 8080 --timeout 30.5 --debug
