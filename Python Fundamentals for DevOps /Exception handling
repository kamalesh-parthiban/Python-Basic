8. Real DevOps Use Cases
✅ SSH Connection Error Handling

import paramiko

def connect_to_server(host, username, password):
    try:
        ssh = paramiko.SSHClient()
        ssh.set_missing_host_key_policy(
            paramiko.AutoAddPolicy()
        )
        ssh.connect(
            host,
            username=username,
            password=password,
            timeout=10
        )
        print(f"✅ Connected to {host}")
        return ssh

    except paramiko.AuthenticationException:
        print(f"❌ Wrong username/password for {host}")
        return None

    except paramiko.SSHException:
        print(f"❌ SSH error connecting to {host}")
        return None

    except TimeoutError:
        print(f"❌ Connection timeout: {host}")
        return None

    except Exception as e:
        print(f"❌ Unknown error: {e}")
        return None

# Use function
ssh = connect_to_server(
    '192.168.1.1',
    'ubuntu',
    'password'
)

if ssh:
    # Use connection
    ssh.exec_command('ls -la')
    ssh.close()
else:
    print("Could not connect!")

✅ Docker Error Handling

import docker

client = docker.from_env()

def deploy_container(image, name, port):
    try:
        # Stop old container
        try:
            old = client.containers.get(name)
            old.stop()
            old.remove()
            print(f"✅ Old {name} removed")
        except docker.errors.NotFound:
            print(f"No existing {name} found")

        # Pull latest image
        print(f"Pulling {image}...")
        client.images.pull(image)

        # Start new container
        client.containers.run(
            image,
            name=name,
            detach=True,
            ports={f'{port}/tcp': port},
            restart_policy={'Name': 'always'}
        )
        print(f"✅ {name} deployed!")
        return True

    except docker.errors.ImageNotFound:
        print(f"❌ Image not found: {image}")
        return False

    except docker.errors.APIError as e:
        print(f"❌ Docker API error: {e}")
        return False

    except Exception as e:
        print(f"❌ Unexpected error: {e}")
        return False

# Use function
success = deploy_container('myapp:latest', 'myapp', 8080)
if not success:
    print("Deployment failed! Alerting team...")

✅ AWS Error Handling

import boto3
from botocore.exceptions import (
    ClientError,
    NoCredentialsError,
    EndpointResolutionError
)

s3 = boto3.client('s3')

def upload_to_s3(file_path, bucket, key):
    try:
        s3.upload_file(file_path, bucket, key)
        print(f"✅ Uploaded to s3://{bucket}/{key}")
        return True

    except FileNotFoundError:
        print(f"❌ Local file not found: {file_path}")
        return False

    except NoCredentialsError:
        print("❌ AWS credentials not configured!")
        return False

    except ClientError as e:
        error_code = e.response['Error']['Code']

        if error_code == 'NoSuchBucket':
            print(f"❌ Bucket not found: {bucket}")
        elif error_code == 'AccessDenied':
            print(f"❌ Access denied to bucket: {bucket}")
        else:
            print(f"❌ AWS error: {e}")
        return False

    except Exception as e:
        print(f"❌ Unknown error: {e}")
        return False

# Use function
upload_to_s3('/var/log/app.log', 'my-bucket', 'logs/app.log')

✅ Kubernetes Error Handling

from kubernetes import client, config
from kubernetes.client.rest import ApiException

config.load_kube_config()
apps_v1 = client.AppsV1Api()
v1      = client.CoreV1Api()

def scale_deployment(name, replicas, namespace='default'):
    try:
        deployment = apps_v1.read_namespaced_deployment(
            name=name,
            namespace=namespace
        )
        deployment.spec.replicas = replicas
        apps_v1.patch_namespaced_deployment(
            name=name,
            namespace=namespace,
            body=deployment
        )
        print(f"✅ Scaled {name} to {replicas}!")
        return True

    except ApiException as e:
        if e.status == 404:
            print(f"❌ Deployment {name} not found!")
        elif e.status == 403:
            print(f"❌ No permission to scale {name}!")
        elif e.status == 422:
            print(f"❌ Invalid replicas value!")
        else:
            print(f"❌ K8s API error: {e}")
        return False

    except Exception as e:
        print(f"❌ Unknown error: {e}")
        return False

def get_pod_logs(name, namespace='default'):
    try:
        logs = v1.read_namespaced_pod_log(
            name=name,
            namespace=namespace
        )
        return logs

    except ApiException as e:
        if e.status == 404:
            print(f"❌ Pod {name} not found!")
        else:
            print(f"❌ Error getting logs: {e}")
        return None

# Use functions
scale_deployment('myapp', 5)
logs = get_pod_logs('myapp-pod')

✅ HTTP Request Error Handling

import requests

def call_api(url, retries=3):
    attempt = 0

    while attempt < retries:
        attempt += 1

        try:
            response = requests.get(url, timeout=10)
            response.raise_for_status()
            return response.json()

        except requests.exceptions.ConnectionError:
            print(f"❌ Cannot connect to {url}")
            print(f"Attempt {attempt}/{retries}")

        except requests.exceptions.Timeout:
            print(f"❌ Request timed out")
            print(f"Attempt {attempt}/{retries}")

        except requests.exceptions.HTTPError as e:
            status = e.response.status_code

            if status == 404:
                print(f"❌ Not found: {url}")
                return None     # Don't retry 404

            elif status == 401:
                print(f"❌ Unauthorized!")
                return None     # Don't retry auth errors

            elif status == 500:
                print(f"❌ Server error, retrying...")

            else:
                print(f"❌ HTTP error: {status}")

        except Exception as e:
            print(f"❌ Unknown error: {e}")
            return None

    print(f"❌ All {retries} attempts failed!")
    return None

# Use function
data = call_api('https://api.example.com/status')
if data:
    print(f"API Response: {data}")

✅ Full Deployment with Error Handling

import subprocess
import logging
import sys

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger('deployment')

class DeploymentError(Exception):
    pass

def run_command(cmd, step):
    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            check=True
        )
        logger.info(f"✅ {step} succeeded")
        return result.stdout

    except subprocess.CalledProcessError as e:
        logger.error(f"❌ {step} failed!")
        logger.error(f"Error: {e.stderr}")
        raise DeploymentError(
            f"{step} failed: {e.stderr}"
        )

def deploy(environment):
    logger.info(f"Starting deployment to {environment}")

    try:
        # Step 1 - Pull code
        run_command(
            ['git', 'pull', 'origin', 'main'],
            'Pull code'
        )

        # Step 2 - Run tests
        run_command(
            ['python', '-m', 'pytest'],
            'Run tests'
        )

        # Step 3 - Build image
        run_command(
            ['docker', 'build', '-t', 'myapp:latest', '.'],
            'Build image'
        )

        # Step 4 - Deploy
        run_command(
            ['kubectl', 'apply', '-f', 'deployment.yaml'],
            'Deploy to K8s'
        )

        logger.info("✅ Deployment successful!")
        return True

    except DeploymentError as e:
        logger.error(f"❌ Deployment failed: {e}")
        # Rollback
        try:
            run_command(
                ['kubectl', 'rollout', 'undo',
                 'deployment/myapp'],
                'Rollback'
            )
            logger.info("✅ Rollback successful!")
        except DeploymentError:
            logger.error("❌ Rollback also failed!")
        return False

    except KeyboardInterrupt:
        logger.warning("⚠️ Deployment cancelled by user!")
        return False

    except Exception as e:
        logger.error(f"❌ Unexpected error: {e}")
        return False

    finally:
        logger.info("Deployment process finished")

# Run deployment
success = deploy('production')
sys.exit(0 if success else 1)
