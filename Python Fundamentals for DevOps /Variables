------------------------------------------------------------------------------------------------------------------------------
2. Variable Rules

# ✅ Valid variable names
myapp       = 'app'
my_app      = 'app'     # underscore allowed
myApp       = 'app'     # camelCase allowed
app123      = 'app'     # numbers allowed (not at start)
_app        = 'app'     # underscore at start allowed

# ❌ Invalid variable names
123app      = 'app'     # ERROR - cannot start with number
my-app      = 'app'     # ERROR - hyphen not allowed
my app      = 'app'     # ERROR - space not allowed
class       = 'app'     # ERROR - reserved keyword

# ✅ Good naming convention (use underscore)
server_ip   = '192.168.1.1'
db_password = 'secret'
max_retries = 3
------------------------------------------------------------------------------------------------------------------------------
3. Variable Types

# String - text
name    = 'myapp'
print(type(name))       # <class 'str'>

# Integer - whole number
port    = 8080
print(type(port))       # <class 'int'>

# Float - decimal number
timeout = 30.5
print(type(timeout))    # <class 'float'>

# Boolean - True or False
debug   = True
print(type(debug))      # <class 'bool'>

# List - collection
servers = ['web1', 'web2']
print(type(servers))    # <class 'list'>

# Dictionary - key value
config  = {'host': 'localhost'}
print(type(config))     # <class 'dict'>

# None - empty
result  = None
print(type(result))     # <class 'NoneType'>
------------------------------------------------------------------------------------------------------------------------------
4. Change Variable Value

# Variables can change!
status = 'stopped'
print(status)       # stopped

status = 'starting'
print(status)       # starting

status = 'running'
print(status)       # running

# Number changes
replicas = 1
print(replicas)     # 1

replicas = replicas + 2
print(replicas)     # 3

replicas += 2       # Short form
print(replicas)     # 5

replicas -= 1       # Subtract
print(replicas)     # 4

replicas *= 2       # Multiply
print(replicas)     # 8

replicas //= 2      # Divide
print(replicas)     # 4
------------------------------------------------------------------------------------------------------------------------------
5. Multiple Assignment

# Assign same value to multiple variables
web1 = web2 = web3 = 'running'
print(web1)     # running
print(web2)     # running
print(web3)     # running

# Assign multiple values at once
host, port, user = 'localhost', 8080, 'ubuntu'
print(host)     # localhost
print(port)     # 8080
print(user)     # ubuntu

# Swap variables
a = 'web1'
b = 'web2'
a, b = b, a     # Swap!
print(a)        # web2
print(b)        # web1
------------------------------------------------------------------------------------------------------------------------------
6. Type Conversion

# Convert between types

# String to Integer
port_str = '8080'
port_int = int(port_str)
print(port_int + 1)     # 8081

# Integer to String
port     = 8080
port_str = str(port)
print('Port: ' + port_str)  # Port: 8080

# String to Float
cpu_str  = '85.5'
cpu      = float(cpu_str)
print(cpu + 1.5)        # 87.0

# Integer to Boolean
print(bool(0))          # False
print(bool(1))          # True
print(bool(-1))         # True

# String to Boolean
print(bool(''))         # False
print(bool('hello'))    # True
------------------------------------------------------------------------------------------------------------------------------
7. Constants – Variables That Don't Change

# Python has no built-in constants
# Convention: USE ALL CAPS for constants

MAX_RETRIES     = 3
TIMEOUT         = 30
DEFAULT_PORT    = 8080
DB_HOST         = 'localhost'
AWS_REGION      = 'us-east-1'

# These SHOULD NOT change
# but Python doesn't force it
# It's just a convention to use CAPS
------------------------------------------------------------------------------------------------------------------------------
8. Global vs Local Variables

# Global variable - available everywhere
server_ip = '192.168.1.1'

def deploy():
    # Local variable - only inside function
    status = 'deploying'
    print(f"Deploying to {server_ip}")  # Can use global
    print(f"Status: {status}")          # Can use local

deploy()
print(server_ip)    # ✅ Works - global
print(status)       # ❌ ERROR - local variable!

# Use global keyword to modify global variable
count = 0

def increment():
    global count    # Tell Python to use global count
    count += 1

increment()
increment()
print(count)        # 2
