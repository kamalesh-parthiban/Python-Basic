9. Real DevOps Use Cases
✅ Store Configuration

import os

# Store all config in variables
APP_NAME     = 'myapp'
ENVIRONMENT  = os.environ.get('ENV', 'staging')
DB_HOST      = os.environ.get('DB_HOST', 'localhost')
DB_PORT      = int(os.environ.get('DB_PORT', '5432'))
DB_NAME      = os.environ.get('DB_NAME', 'mydb')
DEBUG        = ENVIRONMENT != 'production'
REPLICAS     = 5 if ENVIRONMENT == 'production' else 2
PORT         = 80 if ENVIRONMENT == 'production' else 8080

print(f"App:      {APP_NAME}")
print(f"Env:      {ENVIRONMENT}")
print(f"DB:       {DB_HOST}:{DB_PORT}/{DB_NAME}")
print(f"Debug:    {DEBUG}")
print(f"Replicas: {REPLICAS}")
print(f"Port:     {PORT}")

✅ Track Deployment Status

import datetime

# Deployment tracking variables
deployment_start    = datetime.datetime.now()
deployment_success  = False
deployment_error    = None
deployed_servers    = []
failed_servers      = []
total_servers       = 5

servers = ['web1', 'web2', 'web3', 'web4', 'web5']

for server in servers:
    try:
        print(f"Deploying to {server}...")
        # deploy logic
        deployed_servers.append(server)

    except Exception as e:
        failed_servers.append(server)
        deployment_error = str(e)

# Calculate results
deployment_end      = datetime.datetime.now()
deployment_duration = (deployment_end - deployment_start).seconds
deployment_success  = len(failed_servers) == 0

print(f"\nDeployment Report:")
print(f"Success:   {deployment_success}")
print(f"Duration:  {deployment_duration}s")
print(f"Deployed:  {len(deployed_servers)}/{total_servers}")
print(f"Failed:    {len(failed_servers)}")

✅ Server Health Variables

import subprocess

# Health check variables
server          = '192.168.1.1'
is_online       = False
disk_usage      = 0
memory_usage    = 0
cpu_usage       = 0
health_status   = 'unknown'

# Check disk
result      = subprocess.run(
    ['df', '-h', '/'],
    capture_output=True, text=True
)
disk_usage  = int(
    result.stdout.split('\n')[1].split()[4].replace('%','')
)

# Check memory
result          = subprocess.run(
    ['free', '-m'],
    capture_output=True, text=True
)
mem_line        = result.stdout.split('\n')[1].split()
total_mem       = int(mem_line[1])
used_mem        = int(mem_line[2])
memory_usage    = int((used_mem / total_mem) * 100)

# Determine health status
if disk_usage > 90 or memory_usage > 90:
    health_status = 'critical'
elif disk_usage > 80 or memory_usage > 80:
    health_status = 'warning'
else:
    health_status = 'healthy'

print(f"Server:  {server}")
print(f"Disk:    {disk_usage}%")
print(f"Memory:  {memory_usage}%")
print(f"Status:  {health_status}")

✅ AWS Resource Counter

import boto3

ec2 = boto3.client('ec2', region_name='us-east-1')

# Counter variables
total_instances     = 0
running_instances   = 0
stopped_instances   = 0
total_cost_estimate = 0.0

# Instance costs per hour
COST_PER_HOUR = {
    't2.micro':  0.0116,
    't2.small':  0.023,
    't2.medium': 0.0464,
    't3.large':  0.0832
}

response = ec2.describe_instances()

for reservation in response['Reservations']:
    for instance in reservation['Instances']:
        total_instances += 1
        state           = instance['State']['Name']
        instance_type   = instance['InstanceType']

        if state == 'running':
            running_instances   += 1
            hourly_cost         = COST_PER_HOUR.get(
                instance_type, 0
            )
            total_cost_estimate += hourly_cost

        elif state == 'stopped':
            stopped_instances += 1

print(f"Total:    {total_instances}")
print(f"Running:  {running_instances}")
print(f"Stopped:  {stopped_instances}")
print(f"Est Cost: ${total_cost_estimate:.4f}/hour")
