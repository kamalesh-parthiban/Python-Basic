----------------------------------------------------------------------------------------------------------------------------------------------
1. Create Dictionary

# Empty dictionary
empty = {}

# Simple dictionary
server = {
    'name': 'myapp',
    'ip':   '192.168.1.1',
    'port': 8080
}

# Mixed value types
config = {
    'name':     'myapp',        # string
    'port':     8080,           # integer
    'debug':    True,           # boolean
    'timeout':  30.5,           # float
    'servers':  ['web1','web2'] # list
}
----------------------------------------------------------------------------------------------------------------------------------------------
2. Access Values

server = {
    'name': 'myapp',
    'ip':   '192.168.1.1',
    'port': 8080
}

# Access by key
print(server['name'])       # myapp
print(server['ip'])         # 192.168.1.1
print(server['port'])       # 8080

# Safe access - no error if key missing
print(server.get('name'))           # myapp
print(server.get('cpu', 'N/A'))     # N/A (default)

# Access missing key
print(server['cpu'])        # ERROR - KeyError!
print(server.get('cpu'))    # None - no error!
----------------------------------------------------------------------------------------------------------------------------------------------
3. Add & Update Values

server = {
    'name': 'myapp',
    'port': 8080
}

# Add new key
server['ip'] = '192.168.1.1'
server['env'] = 'production'
print(server)
# {'name': 'myapp', 'port': 8080,
#  'ip': '192.168.1.1', 'env': 'production'}

# Update existing key
server['port'] = 9090
print(server['port'])       # 9090

# Update multiple at once
server.update({
    'port': 443,
    'debug': False,
    'version': 'v2.0'
})
print(server)
----------------------------------------------------------------------------------------------------------------------------------------------
4. Remove Values

server = {
    'name': 'myapp',
    'ip':   '192.168.1.1',
    'port': 8080,
    'debug': True
}

# Remove by key
del server['debug']
print(server)

# Remove and get value
port = server.pop('port')
print(port)     # 8080
print(server)   # port is removed

# Remove last item
last = server.popitem()
print(last)     # ('ip', '192.168.1.1')

# Clear all
server.clear()
print(server)   # {}
----------------------------------------------------------------------------------------------------------------------------------------------
5. Check Keys & Values

server = {
    'name': 'myapp',
    'ip':   '192.168.1.1',
    'port': 8080
}

# Check if key exists
if 'name' in server:
    print("name exists!")

if 'cpu' not in server:
    print("cpu not found!")

# Get all keys
print(server.keys())
# dict_keys(['name', 'ip', 'port'])

# Get all values
print(server.values())
# dict_values(['myapp', '192.168.1.1', 8080])

# Get all key-value pairs
print(server.items())
# dict_items([('name','myapp'),('ip','192.168.1.1')])
----------------------------------------------------------------------------------------------------------------------------------------------
6. Loop Through Dictionary

server = {
    'name': 'myapp',
    'ip':   '192.168.1.1',
    'port': 8080
}

# Loop through keys
for key in server:
    print(key)
# name
# ip
# port

# Loop through values
for value in server.values():
    print(value)
# myapp
# 192.168.1.1
# 8080

# Loop through key & value together
for key, value in server.items():
    print(f"{key} = {value}")
# name = myapp
# ip   = 192.168.1.1
# port = 8080
----------------------------------------------------------------------------------------------------------------------------------------------
7. Nested Dictionary

# Dictionary inside dictionary
servers = {
    'web1': {
        'ip':   '192.168.1.1',
        'port': 80,
        'status': 'running'
    },
    'web2': {
        'ip':   '192.168.1.2',
        'port': 80,
        'status': 'stopped'
    },
    'db1': {
        'ip':   '192.168.1.3',
        'port': 5432,
        'status': 'running'
    }
}

# Access nested values
print(servers['web1']['ip'])        # 192.168.1.1
print(servers['web2']['status'])    # stopped
print(servers['db1']['port'])       # 5432

# Loop through nested
for server_name, details in servers.items():
    print(f"Server: {server_name}")
    print(f"  IP:     {details['ip']}")
    print(f"  Port:   {details['port']}")
    print(f"  Status: {details['status']}")

