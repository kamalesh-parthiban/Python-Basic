✅ Parse API Response

import requests

# API returns dictionary (JSON)
response = requests.get('https://api.github.com/users/torvalds')
user = response.json()   # Returns dictionary!

# Access values
print(user['name'])         # Linus Torvalds
print(user['location'])     # Portland, OR
print(user['public_repos']) # number of repos
print(user['followers'])    # number of followers

# Loop through all data
for key, value in user.items():
    print(f"{key}: {value}")

✅ AWS boto3 Response

import boto3

ec2 = boto3.client('ec2')

# boto3 returns dictionary!
response = ec2.describe_instances()

# Navigate dictionary
for reservation in response['Reservations']:
    for instance in reservation['Instances']:
        print(instance['InstanceId'])
        print(instance['State']['Name'])
        print(instance['InstanceType'])
        print(instance['PublicIpAddress'])

✅ Docker Container Info

import docker

client = docker.from_env()
container = client.containers.get('myapp')

# attrs returns dictionary!
info = container.attrs

print(info['State']['Status'])      # running
print(info['State']['StartedAt'])   # start time
print(info['NetworkSettings']['IPAddress'])  # IP
print(info['Config']['Image'])      # image name

# Loop through environment variables
for env_var in info['Config']['Env']:
    print(env_var)

✅ Kubernetes Pod Info

from kubernetes import client, config

config.load_kube_config()
v1 = client.CoreV1Api()

pods = v1.list_namespaced_pod(namespace='default')

# Build dictionary of pod info
pod_info = {}

for pod in pods.items:
    pod_info[pod.metadata.name] = {
        'status':    pod.status.phase,
        'namespace': pod.metadata.namespace,
        'ip':        pod.status.pod_ip
    }

# Access pod info
for pod_name, details in pod_info.items():
    print(f"Pod: {pod_name}")
    print(f"  Status: {details['status']}")
    print(f"  IP:     {details['ip']}")

✅ Store Deployment Results

import datetime

# Track deployment results
deployment_results = {}

servers = ['web1', 'web2', 'web3']

for server in servers:
    try:
        # Deploy to server
        # subprocess.run(...)

        deployment_results[server] = {
            'status':    'success',
            'time':      str(datetime.datetime.now()),
            'message':   'Deployed successfully'
        }

    except Exception as e:
        deployment_results[server] = {
            'status':  'failed',
            'time':    str(datetime.datetime.now()),
            'message': str(e)
        }

# Print results
for server, result in deployment_results.items():
    print(f"Server: {server}")
    print(f"  Status:  {result['status']}")
    print(f"  Message: {result['message']}")

