import datetime

def write_deploy_log(message, level='INFO'):
    timestamp   = datetime.datetime.now().strftime(
        '%Y-%m-%d %H:%M:%S'
    )
    log_entry   = f"[{timestamp}] [{level}] {message}\n"

    # Write to log file
    with open('deployment.log', 'a') as file:
        file.write(log_entry)

    print(log_entry.strip())

