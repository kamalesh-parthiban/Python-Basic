9. Read CSV File

import csv

# Write CSV file
data = [
    ['server', 'ip', 'status'],
    ['web1', '192.168.1.1', 'running'],
    ['web2', '192.168.1.2', 'stopped'],
    ['web3', '192.168.1.3', 'running']
]

with open('servers.csv', 'w', newline='') as file:
    writer = csv.writer(file)
    writer.writerows(data)

# Read CSV file
with open('servers.csv', 'r') as file:
    reader = csv.reader(file)
    for row in reader:
        print(row)
# ['server', 'ip', 'status']
# ['web1', '192.168.1.1', 'running']

# Read CSV as dictionary
with open('servers.csv', 'r') as file:
    reader = csv.DictReader(file)
    for row in reader:
        print(f"Server: {row['server']}")
        print(f"IP:     {row['ip']}")
        print(f"Status: {row['status']}")
