✅ Parse Application Logs

import os

def parse_logs(log_file):
    errors      = []
    warnings    = []
    total_lines = 0

    if not os.path.exists(log_file):
        print(f"Log file not found: {log_file}")
        return

    with open(log_file, 'r') as file:
        for line in file:
            line        = line.strip()
            total_lines += 1

            if 'ERROR' in line:
                errors.append(line)
            elif 'WARNING' in line:
                warnings.append(line)

    print(f"Total lines:  {total_lines}")
    print(f"Errors:       {len(errors)}")
    print(f"Warnings:     {len(warnings)}")

    if errors:
        print("\nErrors found:")
        for error in errors[:5]:    # Show first 5
            print(f"  {error}")

parse_logs('/var/log/app.log')

✅ Backup Log Files

import os
import shutil
import datetime

def backup_logs(log_dir, backup_dir):
    # Create backup directory
    date        = datetime.datetime.now().strftime('%Y%m%d')
    backup_path = os.path.join(backup_dir, date)
    os.makedirs(backup_path, exist_ok=True)

    backed_up   = 0

    # Find all log files
    for root, dirs, files in os.walk(log_dir):
        for filename in files:
            if filename.endswith('.log'):
                src  = os.path.join(root, filename)
                dest = os.path.join(backup_path, filename)

                shutil.copy(src, dest)
                backed_up += 1
                print(f"✅ Backed up: {filename}")

    print(f"\nTotal backed up: {backed_up} files")
    print(f"Backup location: {backup_path}")
    return backed_up

backup_logs('/var/log', '/backup')

✅ Generate Server Report

import datetime
import subprocess

def generate_server_report(output_file):
    timestamp   = datetime.datetime.now().strftime(
        '%Y-%m-%d %H:%M:%S'
    )

    with open(output_file, 'w') as file:
        # Write header
        file.write("=" * 50 + "\n")
        file.write(f"SERVER REPORT - {timestamp}\n")
        file.write("=" * 50 + "\n\n")

        # Disk usage
        result = subprocess.run(
            ['df', '-h'],
            capture_output=True, text=True
        )
        file.write("DISK USAGE:\n")
        file.write(result.stdout + "\n")

        # Memory usage
        result = subprocess.run(
            ['free', '-h'],
            capture_output=True, text=True
        )
        file.write("MEMORY USAGE:\n")
        file.write(result.stdout + "\n")

        # Running processes
        result = subprocess.run(
            ['ps', 'aux', '--sort=-%cpu'],
            capture_output=True, text=True
        )
        file.write("TOP PROCESSES:\n")
        # Write first 10 lines only
        lines = result.stdout.split('\n')[:10]
        file.write('\n'.join(lines) + "\n")

    print(f"✅ Report saved to {output_file}")

generate_server_report('server_report.txt')

✅ Update Config File

import json
import sys

def update_config(config_file, key, value):
    # Read existing config
    with open(config_file, 'r') as file:
        config = json.load(file)

    # Update value
    old_value       = config.get(key)
    config[key]     = value

    # Write back
    with open(config_file, 'w') as file:
        json.dump(config, file, indent=4)

    print(f"✅ Updated {key}: {old_value} → {value}")

def update_nested_config(config_file, section, key, value):
    with open(config_file, 'r') as file:
        config = json.load(file)

    if section not in config:
        config[section] = {}

    config[section][key] = value

    with open(config_file, 'w') as file:
        json.dump(config, file, indent=4)

    print(f"✅ Updated {section}.{key} = {value}")

# Use functions
update_config('config.json', 'port', 9090)
update_config('config.json', 'debug', False)
update_nested_config('config.json', 'database',
                     'host', 'prod-db.example.com')

✅ Process Multiple Config Files

import os
import yaml

def process_all_configs(config_dir):
    configs = {}

    # Read all yaml files in directory
    for filename in os.listdir(config_dir):
        if filename.endswith('.yaml') or \
           filename.endswith('.yml'):

            filepath = os.path.join(config_dir, filename)

            with open(filepath, 'r') as file:
                config = yaml.safe_load(file)

            app_name        = filename.replace('.yaml', '')
            configs[app_name] = config
            print(f"✅ Loaded: {filename}")

    return configs

# Use function
all_configs = process_all_configs('/etc/myapp/configs')

for app, config in all_configs.items():
    print(f"\nApp: {app}")
    print(f"Port: {config.get('port')}")
    print(f"Env:  {config.get('environment')}")
