9. Nested If

env     = 'production'
version = 'v2.0'
tested  = True

if env == 'production':
    print("Production deployment!")

    if not tested:
        print("ERROR: Not tested!")
        sys.exit(1)

    if version == 'v2.0':
        print("Deploying v2.0...")
    else:
        print(f"Deploying {version}...")

else:
    print(f"Deploying to {env}...")
-----------------------------------------------------------------------------------------------------------------------
10. One Line If (Ternary)

cpu = 85

# Normal if/else
if cpu > 80:
    status = 'HIGH'
else:
    status = 'NORMAL'

# One line version
status = 'HIGH' if cpu > 80 else 'NORMAL'
print(status)   # HIGH

# Real DevOps use
replicas = 5 if env == 'production' else 2
debug    = True if env == 'development' else False
port     = 80 if env == 'production' else 8080
