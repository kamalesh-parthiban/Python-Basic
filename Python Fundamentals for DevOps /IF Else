11. Real DevOps Use Cases
✅ Check Environment Before Deploy

import sys

env = sys.argv[1]

# Validate environment
if env not in ['production', 'staging', 'development']:
    print(f"ERROR: Invalid environment {env}!")
    sys.exit(1)

# Extra check for production
if env == 'production':
    confirm = input("Deploy to PRODUCTION? (yes/no): ")
    if confirm != 'yes':
        print("Deployment cancelled!")
        sys.exit(0)

print(f"Deploying to {env}...")

✅ Check Server Health

import subprocess

def check_server_health(server):
    # Ping server
    result = subprocess.run(
        ['ping', '-c', '1', server],
        capture_output=True
    )

    if result.returncode == 0:
        print(f"{server} is UP ✅")
        return True
    else:
        print(f"{server} is DOWN ❌")
        return False

servers = ['192.168.1.1', '192.168.1.2', '192.168.1.3']

for server in servers:
    is_healthy = check_server_health(server)

    if not is_healthy:
        print(f"ALERT: {server} is down!")
        # Send alert...

✅ Check Disk Space

import subprocess

result = subprocess.run(
    ['df', '-h', '/'],
    capture_output=True,
    text=True
)

lines = result.stdout.strip().split('\n')
data  = lines[1].split()
usage = int(data[4].replace('%', ''))

if usage >= 90:
    print(f"CRITICAL: Disk {usage}% full!")
    # Send critical alert
elif usage >= 80:
    print(f"WARNING: Disk {usage}% full!")
    # Send warning alert
elif usage >= 70:
    print(f"CAUTION: Disk {usage}% used")
else:
    print(f"OK: Disk {usage}% used ✅")

✅ Docker Container Check

import docker

client = docker.from_env()

def check_container(name):
    try:
        container = client.containers.get(name)

        if container.status == 'running':
            print(f"{name} is running ✅")

        elif container.status == 'exited':
            print(f"{name} has stopped!")
            print("Restarting...")
            container.restart()

        elif container.status == 'paused':
            print(f"{name} is paused!")
            container.unpause()

        else:
            print(f"{name} status: {container.status}")

    except docker.errors.NotFound:
        print(f"ERROR: {name} not found!")
        print("Starting new container...")
        client.containers.run(name, detach=True)

check_container('myapp')
check_container('nginx')
check_container('postgres')

✅ AWS Instance Check

import boto3

ec2 = boto3.client('ec2', region_name='us-east-1')

response = ec2.describe_instances()

for reservation in response['Reservations']:
    for instance in reservation['Instances']:
        instance_id = instance['InstanceId']
        state       = instance['State']['Name']
        type_       = instance['InstanceType']

        if state == 'running':
            print(f"{instance_id} is running ✅")

        elif state == 'stopped':
            print(f"{instance_id} is stopped!")

            # Auto start stopped instances
            if type_ == 't2.micro':
                ec2.start_instances(
                    InstanceIds=[instance_id]
                )
                print(f"Started {instance_id}!")

        elif state == 'terminated':
            print(f"{instance_id} is terminated!")

        else:
            print(f"{instance_id} state: {state}")

✅ Kubernetes Pod Status Check

from kubernetes import client, config

config.load_kube_config()
v1 = client.CoreV1Api()

pods = v1.list_namespaced_pod(namespace='default')

for pod in pods.items:
    name   = pod.metadata.name
    status = pod.status.phase

    if status == 'Running':
        print(f"{name} is running ✅")

    elif status == 'Pending':
        print(f"{name} is pending...")
        # Wait or investigate

    elif status == 'Failed':
        print(f"{name} has FAILED! ❌")
        # Get logs
        logs = v1.read_namespaced_pod_log(
            name=name,
            namespace='default'
        )
        print(f"Logs: {logs}")
        # Restart pod
        v1.delete_namespaced_pod(
            name=name,
            namespace='default'
        )

    elif status == 'Succeeded':
        print(f"{name} completed successfully!")

    else:
        print(f"{name} unknown status: {status}")
