5. Check String Content

# Check what string contains
print('hello'.isalpha())    # True  - only letters
print('12345'.isdigit())    # True  - only numbers
print('hello1'.isalnum())   # True  - letters & numbers
print('  '.isspace())       # True  - only spaces
print('HELLO'.isupper())    # True  - all uppercase
print('hello'.islower())    # True  - all lowercase

# Real DevOps use
port = '8080'
if port.isdigit():
    port = int(port)
    print(f"Valid port: {port}")
else:
    print("Invalid port!")
------------------------------------------------------------------------------------------------------------------------------------------------
6. String Formatting

name = 'myapp'
env  = 'production'
port = 8080

# f-string (Best way - Modern)
print(f"Deploying {name} to {env} on port {port}")
# Deploying myapp to production on port 8080

# format() method
print("Deploying {} to {} on port {}".format(name, env, port))

# % formatting (Old way)
print("Deploying %s to %s on port %d" % (name, env, port))

# f-string with expressions
replicas = 3
print(f"Total servers: {replicas * 2}")   # Total servers: 6
print(f"Env upper: {env.upper()}")        # Env upper: PRODUCTION
------------------------------------------------------------------------------------------------------------------------------------------------
7. String Concatenation

# Join strings together
first = 'Hello'
second = 'World'

# Using + operator
result = first + ' ' + second
print(result)   # Hello World

# Using f-string (better)
result = f"{first} {second}"
print(result)   # Hello World

# Join many strings
server  = 'web1'
domain  = '.example.com'
url     = 'https://' + server + domain
print(url)  # https://web1.example.com

# Better with f-string
url = f"https://{server}{domain}"
print(url)  # https://web1.example.com
