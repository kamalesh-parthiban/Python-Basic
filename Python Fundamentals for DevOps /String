10. Real DevOps Use Cases
✅ Parse Log Files

# Read and parse log file
with open('/var/log/app.log', 'r') as f:
    for line in f:
        line = line.strip()   # Remove spaces

        # Check log level
        if 'ERROR' in line:
            print(f"Error found: {line}")

        elif 'WARNING' in line:
            print(f"Warning: {line}")

        # Extract IP from log
        if line.startswith('192.168'):
            ip = line.split(' ')[0]
            print(f"Request from: {ip}")

