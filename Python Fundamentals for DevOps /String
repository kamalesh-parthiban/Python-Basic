------------------------------------------------------------------------------------------------------------------------------------------------
3. String Slicing

text = 'production-server-v2'

# Get portion of string
print(text[0:10])    # production
print(text[11:17])   # server
print(text[18:])     # v2
print(text[:10])     # production
print(text[-2:])     # v2

# Every 2nd character
print(text[::2])     # pouto-evr2
------------------------------------------------------------------------------------------------------------------------------------------------
4. String Methods

text = '  Hello Production Server  '

# Case
print(text.upper())         # HELLO PRODUCTION SERVER
print(text.lower())         # hello production server
print(text.title())         # Hello Production Server

# Remove spaces
print(text.strip())         # 'Hello Production Server'
print(text.lstrip())        # Remove left spaces
print(text.rstrip())        # Remove right spaces

# Replace
print(text.replace('Production', 'Staging'))
# Hello Staging Server

# Split string into list
servers = 'web1,web2,web3'
print(servers.split(','))   # ['web1', 'web2', 'web3']

# Join list into string
servers = ['web1', 'web2', 'web3']
print(','.join(servers))    # web1,web2,web3

# Find
text = 'production-server'
print(text.find('server'))  # 11 (position)
print(text.find('xyz'))     # -1 (not found)

# Count
text = 'web1 web2 web1 web1'
print(text.count('web1'))   # 3

# Check start & end
url = 'https://myapp.com'
print(url.startswith('https'))  # True
print(url.endswith('.com'))     # True
