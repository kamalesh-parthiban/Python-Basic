✅ Parse Server Response

import subprocess

# Get disk usage
result = subprocess.run(
    ['df', '-h', '/'],
    capture_output=True,
    text=True
)

output = result.stdout

# Split into lines
lines = output.strip().split('\n')

# Get second line (data line)
data_line = lines[1]

# Split by spaces
parts = data_line.split()

total   = parts[1]   # Total space
used    = parts[2]   # Used space
free    = parts[3]   # Free space
percent = parts[4]   # Usage percent

print(f"Total:   {total}")
print(f"Used:    {used}")
print(f"Free:    {free}")
print(f"Usage:   {percent}")

✅ Generate Config Files

# Generate nginx config using strings
server_name = 'myapp.example.com'
port        = 8080
app_port    = 3000

nginx_config = f"""
server {{
    listen {port};
    server_name {server_name};

    location / {{
        proxy_pass http://localhost:{app_port};
        proxy_set_header Host $host;
    }}
}}
"""

# Save config file
with open('/etc/nginx/sites-available/myapp', 'w') as f:
    f.write(nginx_config)

print("Nginx config created! ✅")

✅ Process Environment Variables

import os

# Get env var as string
db_url = os.environ.get('DATABASE_URL', '')

# Parse db url
# postgresql://user:password@localhost:5432/mydb

if db_url.startswith('postgresql://'):
    # Remove prefix
    url = db_url.replace('postgresql://', '')

    # Split user info and host info
    user_info, host_info = url.split('@')

    # Get username and password
    username, password = user_info.split(':')

    # Get host and db
    host_port, db_name = host_info.split('/')

    # Get host and port
    host, port = host_port.split(':')

    print(f"Username: {username}")
    print(f"Host:     {host}")
    print(f"Port:     {port}")
    print(f"Database: {db_name}")
