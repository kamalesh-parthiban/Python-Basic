5. Set Operations – Most Powerful Feature!

# These are the most useful Set operations!

set_a = {'web1', 'web2', 'web3', 'web4'}
set_b = {'web3', 'web4', 'web5', 'web6'}

Union – All items from BOTH sets

# Combine both sets
result = set_a | set_b
# OR
result = set_a.union(set_b)

print(result)
# {'web1', 'web2', 'web3', 'web4', 'web5', 'web6'}

Intersection – Items in BOTH sets

# Common items only
result = set_a & set_b
# OR
result = set_a.intersection(set_b)

print(result)
# {'web3', 'web4'}

Difference – Items only in first set

# Items in set_a but NOT in set_b
result = set_a - set_b
# OR
result = set_a.difference(set_b)

print(result)
# {'web1', 'web2'}

# Items in set_b but NOT in set_a
result = set_b - set_a
print(result)
# {'web5', 'web6'}

Symmetric Difference – Items NOT in both

# Items that are unique to each set
result = set_a ^ set_b
# OR
result = set_a.symmetric_difference(set_b)

print(result)
# {'web1', 'web2', 'web5', 'web6'}
----------------------------------------------------------------------------------------------------------------------------------------
6. Set Comparison

set_a = {'web1', 'web2', 'web3'}
set_b = {'web1', 'web2'}
set_c = {'web4', 'web5'}

# Is subset? (all items of b in a?)
print(set_b.issubset(set_a))      # True
print(set_c.issubset(set_a))      # False

# Is superset? (a contains all of b?)
print(set_a.issuperset(set_b))    # True

# Are they completely different?
print(set_a.isdisjoint(set_c))    # True  (no common items)
print(set_a.isdisjoint(set_b))    # False (has common items)
