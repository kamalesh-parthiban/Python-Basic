8. Real DevOps Use Cases
✅ Find Unique Servers from Logs

# Log file has repeated server names
log_entries = [
    'web1 - GET /api - 200',
    'web2 - POST /login - 401',
    'web1 - GET /home - 200',
    'web3 - GET /api - 500',
    'web2 - GET /api - 200',
    'web1 - DELETE /user - 403'
]

# Extract server names
servers = []
for entry in log_entries:
    server = entry.split(' ')[0]
    servers.append(server)

print(servers)
# ['web1','web2','web1','web3','web2','web1']

# Get unique servers
unique_servers = set(servers)
print(unique_servers)
# {'web1', 'web2', 'web3'}

print(f"Total unique servers: {len(unique_servers)}")

✅ Compare Deployed vs Expected Servers

# Servers that SHOULD be running
expected_servers = {'web1', 'web2', 'web3', 'web4', 'web5'}

# Servers that ARE actually running
running_servers  = {'web1', 'web2', 'web3'}

# Find missing servers
missing = expected_servers - running_servers
print(f"Missing servers: {missing}")
# Missing servers: {'web4', 'web5'}

# Find extra servers (shouldn't be running)
extra = running_servers - expected_servers
print(f"Extra servers: {extra}")

# Find common (correctly running)
correct = expected_servers & running_servers
print(f"Running correctly: {correct}")
# Running correctly: {'web1', 'web2', 'web3'}

✅ Find Duplicate Packages

# Packages installed on server1
server1_packages = {
    'nginx', 'python3', 'git', 'docker', 'curl'
}

# Packages installed on server2
server2_packages = {
    'apache2', 'python3', 'git', 'nodejs', 'curl'
}

# Packages on BOTH servers
common = server1_packages & server2_packages
print(f"Common packages: {common}")
# {'python3', 'git', 'curl'}

# Packages only on server1
only_server1 = server1_packages - server2_packages
print(f"Only on server1: {only_server1}")
# {'nginx', 'docker'}

# Packages only on server2
only_server2 = server2_packages - server1_packages
print(f"Only on server2: {only_server2}")
# {'apache2', 'nodejs'}

# All packages combined
all_packages = server1_packages | server2_packages
print(f"All packages: {all_packages}")

✅ Find Unique Error Types in Logs

import subprocess

# Get all errors from log
result = subprocess.run(
    ['grep', 'ERROR', '/var/log/app.log'],
    capture_output=True,
    text=True
)

error_types = set()

for line in result.stdout.split('\n'):
    if 'ERROR' in line:
        # Extract error type
        error_type = line.split('ERROR:')[1].split(':')[0].strip()
        error_types.add(error_type)

print("Unique error types found:")
for error in error_types:
    print(f"  - {error}")

✅ Track Deployed Versions

# Versions deployed to each environment
production_versions = {'v1.0', 'v1.1', 'v1.2', 'v2.0'}
staging_versions    = {'v1.2', 'v2.0', 'v2.1', 'v2.2'}

# Versions in staging but NOT production (not released yet)
unreleased = staging_versions - production_versions
print(f"Unreleased versions: {unreleased}")
# {'v2.1', 'v2.2'}

# Versions in BOTH (tested and released)
tested_and_released = production_versions & staging_versions
print(f"Tested & released: {tested_and_released}")
# {'v1.2', 'v2.0'}

# All versions across both
all_versions = production_versions | staging_versions
print(f"All versions: {all_versions}")
