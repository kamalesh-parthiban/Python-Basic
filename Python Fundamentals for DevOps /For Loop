8. For with Else

servers = ['web1', 'web2', 'web3']

# Else runs when loop completes without break
for server in servers:
    if server == 'web99':
        print("Found web99!")
        break
else:
    print("web99 not found in any server!")

# Output: web99 not found in any server!
