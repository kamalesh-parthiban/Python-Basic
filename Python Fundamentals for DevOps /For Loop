1. Basic For Loop

# Loop through list
servers = ['web1', 'web2', 'web3']

for server in servers:
    print(server)

# Output:
# web1
# web2
# web3
-------------------------------------------------------------------------------------------------------------------------------------------
2. Loop Through Different Collections

# Loop through LIST
servers = ['web1', 'web2', 'web3']
for server in servers:
    print(server)

# Loop through TUPLE
environments = ('production', 'staging', 'development')
for env in environments:
    print(env)

# Loop through SET
unique_ips = {'192.168.1.1', '192.168.1.2'}
for ip in unique_ips:
    print(ip)

# Loop through DICTIONARY
config = {'host': 'localhost', 'port': 8080, 'env': 'prod'}

# Keys only
for key in config:
    print(key)

# Values only
for value in config.values():
    print(value)

# Keys and Values together
for key, value in config.items():
    print(f"{key} = {value}")

# Loop through STRING
for char in 'hello':
    print(char)
# h e l l o
-------------------------------------------------------------------------------------------------------------------------------------------
3. Range – Loop Numbers

# range(stop)
for i in range(5):
    print(i)
# 0 1 2 3 4

# range(start, stop)
for i in range(1, 6):
    print(i)
# 1 2 3 4 5

# range(start, stop, step)
for i in range(0, 10, 2):
    print(i)
# 0 2 4 6 8

# Count down
for i in range(5, 0, -1):
    print(i)
# 5 4 3 2 1
-------------------------------------------------------------------------------------------------------------------------------------------
4. Enumerate – Get Index & Value

servers = ['web1', 'web2', 'web3']

# Without enumerate
for server in servers:
    print(server)   # No index

# With enumerate - get index too!
for index, server in enumerate(servers):
    print(f"{index}: {server}")
# 0: web1
# 1: web2
# 2: web3

# Start index from 1
for index, server in enumerate(servers, start=1):
    print(f"{index}: {server}")
# 1: web1
# 2: web2
# 3: web3
-------------------------------------------------------------------------------------------------------------------------------------------
5. Break – Stop Loop Early

servers = ['web1', 'web2', 'web3', 'web4', 'web5']

# Stop when web3 is found
for server in servers:
    if server == 'web3':
        print("Found web3! Stopping!")
        break
    print(f"Checking {server}...")

# Output:
# Checking web1...
# Checking web2...
# Found web3! Stopping!
-------------------------------------------------------------------------------------------------------------------------------------------
6. Continue – Skip Current Item

servers = ['web1', 'web2', 'SKIP', 'web3', 'SKIP', 'web4']

# Skip items marked as SKIP
for server in servers:
    if server == 'SKIP':
        continue        # Skip this, go to next
    print(f"Deploying to {server}...")

# Output:
# Deploying to web1...
# Deploying to web2...
# Deploying to web3...
# Deploying to web4...
