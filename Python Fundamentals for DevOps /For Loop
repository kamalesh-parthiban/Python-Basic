9. List Comprehension – Short For Loop

servers = ['web1', 'web2', 'web3']

# Normal loop to create new list
upper_servers = []
for server in servers:
    upper_servers.append(server.upper())
print(upper_servers)   # ['WEB1', 'WEB2', 'WEB3']

# List comprehension - one line!
upper_servers = [server.upper() for server in servers]
print(upper_servers)   # ['WEB1', 'WEB2', 'WEB3']

# With condition
ports = [80, 443, 8080, 22, 3306, 9090]
high_ports = [p for p in ports if p > 1000]
print(high_ports)      # [8080, 3306, 9090]
