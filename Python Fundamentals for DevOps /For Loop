10. Real DevOps Use Cases
✅ Deploy to Multiple Servers

import paramiko

servers = [
    '192.168.1.1',
    '192.168.1.2',
    '192.168.1.3',
    '192.168.1.4'
]

for server in servers:
    print(f"\nDeploying to {server}...")

    try:
        ssh = paramiko.SSHClient()
        ssh.set_missing_host_key_policy(
            paramiko.AutoAddPolicy()
        )
        ssh.connect(server, username='ubuntu',
                    password='password')

        # Run deploy commands
        commands = [
            'git pull origin main',
            'pip install -r requirements.txt',
            'sudo systemctl restart myapp'
        ]

        for cmd in commands:
            print(f"  Running: {cmd}")
            stdin, stdout, stderr = ssh.exec_command(cmd)
            stdout.channel.recv_exit_status()

        ssh.close()
        print(f"  ✅ {server} deployed!")

    except Exception as e:
        print(f"  ❌ {server} failed: {e}")

✅ Check All Docker Containers

import docker

client = docker.from_env()

containers = client.containers.list(all=True)

print("Container Status Report:")
print("-" * 40)

for container in containers:
    name   = container.name
    status = container.status

    if status == 'running':
        print(f"✅ {name:20} RUNNING")
    elif status == 'exited':
        print(f"❌ {name:20} STOPPED")
        # Restart stopped container
        container.restart()
        print(f"🔄 {name:20} RESTARTED")
    else:
        print(f"⚠️  {name:20} {status.upper()}")

✅ Check All Kubernetes Pods

from kubernetes import client, config

config.load_kube_config()
v1 = client.CoreV1Api()

pods = v1.list_pod_for_all_namespaces()

failed_pods  = []
running_pods = []
pending_pods = []

for pod in pods.items:
    name   = pod.metadata.name
    status = pod.status.phase
    ns     = pod.metadata.namespace

    if status == 'Running':
        running_pods.append(name)
    elif status == 'Failed':
        failed_pods.append(name)
    elif status == 'Pending':
        pending_pods.append(name)

print(f"Running: {len(running_pods)}")
print(f"Failed:  {len(failed_pods)}")
print(f"Pending: {len(pending_pods)}")

# Handle failed pods
for pod in failed_pods:
    print(f"Restarting failed pod: {pod}")
    v1.delete_namespaced_pod(name=pod, namespace='default')

✅ Backup Files to S3

import boto3
import os

s3 = boto3.client('s3')

log_files = [
    '/var/log/app.log',
    '/var/log/nginx.log',
    '/var/log/error.log',
    '/var/log/access.log'
]

for file_path in log_files:
    # Check if file exists
    if not os.path.exists(file_path):
        print(f"Skipping {file_path} - not found")
        continue

    # Get filename only
    filename = os.path.basename(file_path)

    # Upload to S3
    print(f"Uploading {filename}...")
    s3.upload_file(
        file_path,
        'my-backup-bucket',
        f'logs/{filename}'
    )
    print(f"✅ {filename} uploaded!")

print("All files backed up!")

✅ Monitor Multiple AWS EC2 Instances

import boto3

ec2 = boto3.client('ec2', region_name='us-east-1')

response = ec2.describe_instances()

stopped_instances  = []
running_instances  = []

for reservation in response['Reservations']:
    for instance in reservation['Instances']:
        id_    = instance['InstanceId']
        state  = instance['State']['Name']
        type_  = instance['InstanceType']

        if state == 'running':
            running_instances.append(id_)
            print(f"✅ {id_} ({type_}) RUNNING")

        elif state == 'stopped':
            stopped_instances.append(id_)
            print(f"❌ {id_} ({type_}) STOPPED")

print(f"\nTotal Running: {len(running_instances)}")
print(f"Total Stopped: {len(stopped_instances)}")

# Start all stopped instances
for instance_id in stopped_instances:
    print(f"Starting {instance_id}...")
    ec2.start_instances(InstanceIds=[instance_id])

✅ Process Log Files

import os

log_dir   = '/var/log'
error_count = 0
errors    = []

# Walk through all log files
for root, dirs, files in os.walk(log_dir):
    for filename in files:
        if filename.endswith('.log'):
            filepath = os.path.join(root, filename)

            # Read each log file
            with open(filepath, 'r') as f:
                for line_num, line in enumerate(f, 1):
                    if 'ERROR' in line:
                        error_count += 1
                        errors.append({
                            'file':    filename,
                            'line':    line_num,
                            'message': line.strip()
                        })

print(f"Total errors found: {error_count}")

for error in errors[:10]:   # Show first 10
    print(f"File: {error['file']}")
    print(f"Line: {error['line']}")
    print(f"Msg:  {error['message']}")
    print("---")

✅ Retry Failed Deployments

import time

servers = ['web1', 'web2', 'web3']
failed  = []

# First deployment attempt
for server in servers:
    try:
        print(f"Deploying to {server}...")
        # deploy logic here
        print(f"✅ {server} done!")
    except Exception as e:
        print(f"❌ {server} failed: {e}")
        failed.append(server)

# Retry failed servers
if failed:
    print(f"\nRetrying {len(failed)} failed servers...")
    time.sleep(5)

    for server in failed:
        for attempt in range(1, 4):   # Try 3 times
            try:
                print(f"Attempt {attempt} for {server}")
                # deploy logic here
                print(f"✅ {server} done!")
                break
            except Exception as e:
                if attempt == 3:
                    print(f"❌ {server} failed after 3 attempts!")
                else:
                    print(f"Retrying in 5 seconds...")
                    time.sleep(5)
