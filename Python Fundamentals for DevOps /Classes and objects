6. Inheritance – Extend a Class

# Base class
class Server:
    def __init__(self, name, ip):
        self.name   = name
        self.ip     = ip
        self.status = 'stopped'

    def start(self):
        self.status = 'running'
        print(f"✅ {self.name} started!")

    def stop(self):
        self.status = 'stopped'
        print(f"❌ {self.name} stopped!")

    def info(self):
        print(f"Name: {self.name}, IP: {self.ip}")

# Child class - inherits from Server
class WebServer(Server):
    def __init__(self, name, ip, domain):
        super().__init__(name, ip)  # Call parent init
        self.domain = domain

    # Add new method
    def get_url(self):
        return f"https://{self.domain}"

# Another child class
class DBServer(Server):
    def __init__(self, name, ip, db_name):
        super().__init__(name, ip)
        self.db_name = db_name

    # Add new method
    def backup(self):
        print(f"Backing up {self.db_name}...")

# Use child classes
web = WebServer('nginx1', '192.168.1.1', 'myapp.com')
db  = DBServer('postgres1', '192.168.1.2', 'mydb')

web.start()             # From parent
web.info()              # From parent
print(web.get_url())    # From child

db.start()              # From parent
db.backup()             # From child
