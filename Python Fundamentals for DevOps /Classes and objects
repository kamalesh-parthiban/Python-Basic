class Server:
    def __init__(self, name, ip):
        self.name   = name
        self.ip     = ip
        self.status = 'stopped'

    # String representation
    def __str__(self):
        return f"Server({self.name}, {self.ip})"

    # Detailed representation
    def __repr__(self):
        return f"Server(name={self.name}, ip={self.ip})"

    # Compare two servers
    def __eq__(self, other):
        return self.ip == other.ip

    # Length
    def __len__(self):
        return len(self.name)

server = Server('web1', '192.168.1.1')
