✅ Server Manager Class

import paramiko
import subprocess

class ServerManager:
    def __init__(self, host, username, password=None,
                 key_file=None):
        self.host       = host
        self.username   = username
        self.password   = password
        self.key_file   = key_file
        self.ssh        = None
        self.connected  = False

    def connect(self):
        try:
            self.ssh = paramiko.SSHClient()
            self.ssh.set_missing_host_key_policy(
                paramiko.AutoAddPolicy()
            )
            self.ssh.connect(
                self.host,
                username=self.username,
                password=self.password,
                key_filename=self.key_file
            )
            self.connected = True
            print(f"✅ Connected to {self.host}")
        except Exception as e:
            print(f"❌ Connection failed: {e}")

    def disconnect(self):
        if self.ssh:
            self.ssh.close()
            self.connected = False
            print(f"Disconnected from {self.host}")

    def run_command(self, command):
        if not self.connected:
            print("Not connected!")
            return None
        stdin, stdout, stderr = self.ssh.exec_command(
            command
        )
        output      = stdout.read().decode('utf-8')
        error       = stderr.read().decode('utf-8')
        exit_code   = stdout.channel.recv_exit_status()
        return output, error, exit_code

    def upload_file(self, local, remote):
        if not self.connected:
            return False
        sftp = self.ssh.open_sftp()
        sftp.put(local, remote)
        sftp.close()
        print(f"✅ Uploaded {local} to {remote}")
        return True

    def get_disk_usage(self):
        output, _, _ = self.run_command('df -h /')
        return output

    def restart_service(self, service):
        _, _, code = self.run_command(
            f'sudo systemctl restart {service}'
        )
        if code == 0:
            print(f"✅ {service} restarted!")
        else:
            print(f"❌ Failed to restart {service}")

# Use class
server = ServerManager(
    host='192.168.1.1',
    username='ubuntu',
    key_file='~/.ssh/id_rsa'
)

server.connect()
print(server.get_disk_usage())
server.restart_service('nginx')
server.upload_file('app.jar', '/opt/myapp/app.jar')
server.disconnect()

✅ Docker Manager Class

import docker

class DockerManager:
    def __init__(self):
        self.client = docker.from_env()
        print("✅ Connected to Docker!")

    def build_image(self, path, tag):
        print(f"Building {tag}...")
        try:
            self.client.images.build(path=path, tag=tag)
            print(f"✅ Built {tag}!")
            return True
        except Exception as e:
            print(f"❌ Build failed: {e}")
            return False

    def pull_image(self, image):
        print(f"Pulling {image}...")
        self.client.images.pull(image)
        print(f"✅ Pulled {image}!")

    def start_container(self, image, name, port,
                        env_vars=None):
        try:
            self.client.containers.run(
                image,
                name=name,
                detach=True,
                ports={f'{port}/tcp': port},
                environment=env_vars or {},
                restart_policy={'Name': 'always'}
            )
            print(f"✅ Started {name}!")
            return True
        except Exception as e:
            print(f"❌ Start failed: {e}")
            return False

    def stop_container(self, name):
        try:
            container = self.client.containers.get(name)
            container.stop()
            container.remove()
            print(f"✅ Stopped {name}!")
            return True
        except docker.errors.NotFound:
            print(f"{name} not found!")
            return False

    def get_container_status(self, name):
        try:
            container = self.client.containers.get(name)
            return container.status
        except docker.errors.NotFound:
            return 'not found'

    def list_containers(self):
        containers = self.client.containers.list(all=True)
        for c in containers:
            print(f"{c.name:20} {c.status}")

    def deploy(self, image, name, port, env_vars=None):
        print(f"\nDeploying {name}...")
        self.stop_container(name)
        self.pull_image(image)
        self.start_container(image, name, port, env_vars)
        print(f"✅ {name} deployed!")

# Use class
docker_mgr = DockerManager()

docker_mgr.deploy(
    image='myapp:latest',
    name='myapp',
    port=8080,
    env_vars={
        'DB_HOST': 'localhost',
        'DB_PASS': 'secret'
    }
)

docker_mgr.list_containers()
print(docker_mgr.get_container_status('myapp'))

✅ AWS Manager Class

import boto3

class AWSManager:
    def __init__(self, region='us-east-1'):
        self.region = region
        self.ec2    = boto3.client('ec2',
                        region_name=region)
        self.s3     = boto3.client('s3')
        print(f"✅ Connected to AWS {region}")

    def get_running_instances(self):
        response    = self.ec2.describe_instances(
            Filters=[{
                'Name':   'instance-state-name',
                'Values': ['running']
            }]
        )
        instances   = []
        for r in response['Reservations']:
            for i in r['Instances']:
                instances.append({
                    'id':   i['InstanceId'],
                    'type': i['InstanceType'],
                    'ip':   i.get('PublicIpAddress', 'N/A')
                })
        return instances

    def start_instance(self, instance_id):
        self.ec2.start_instances(
            InstanceIds=[instance_id]
        )
        print(f"✅ Started {instance_id}!")

    def stop_instance(self, instance_id):
        self.ec2.stop_instances(
            InstanceIds=[instance_id]
        )
        print(f"✅ Stopped {instance_id}!")

    def upload_to_s3(self, file_path, bucket, key):
        try:
            self.s3.upload_file(file_path, bucket, key)
            print(f"✅ Uploaded to s3://{bucket}/{key}")
            return True
        except Exception as e:
            print(f"❌ Upload failed: {e}")
            return False

    def send_alert(self, message, topic_arn):
        sns = boto3.client('sns',
                region_name=self.region)
        sns.publish(
            TopicArn=topic_arn,
            Message=message,
            Subject='AWS Alert'
        )
        print(f"✅ Alert sent!")

# Use class
aws = AWSManager(region='us-east-1')

instances = aws.get_running_instances()
for i in instances:
