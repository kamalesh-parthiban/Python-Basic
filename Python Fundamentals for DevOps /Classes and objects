3. Class with Methods

class Server:
    def __init__(self, name, ip, port):
        self.name   = name
        self.ip     = ip
        self.port   = port
        self.status = 'stopped'

    # Method = function inside class
    def start(self):
        self.status = 'running'
        print(f"{self.name} started! ✅")

    def stop(self):
        self.status = 'stopped'
        print(f"{self.name} stopped!")

    def restart(self):
        self.stop()
        self.start()
        print(f"{self.name} restarted!")

    def get_status(self):
        return self.status

    def info(self):
        print(f"Name:   {self.name}")
        print(f"IP:     {self.ip}")
        print(f"Port:   {self.port}")
        print(f"Status: {self.status}")

# Create and use object
server = Server('web1', '192.168.1.1', 8080)
server.info()
server.start()
server.info()
server.stop()
print(server.get_status())  # stopped
