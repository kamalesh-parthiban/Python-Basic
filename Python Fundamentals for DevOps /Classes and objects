class EC2:
    def __init__(self, instance_id, region):
        self.instance_id = instance_id
        self.region      = region
        self.ec2         = boto3.client('ec2', region_name=region)

    def start(self):
        self.ec2.start_instances(InstanceIds=[self.instance_id])
        print(f"{self.instance_id} started ✅")

    def stop(self):
        self.ec2.stop_instances(InstanceIds=[self.instance_id])
        print(f"{self.instance_id} stopped ✅")

    def status(self):
        response = self.ec2.describe_instances(
            InstanceIds=[self.instance_id]
        )
        state = response['Reservations'][0]['Instances'][0]['State']['Name']
        print(f"{self.instance_id} is {state}")

# Create objects for each instance
jenkins = EC2('i-09519fa48c7c66f84', 'us-east-2')
web     = EC2('i-0123456789abcdef0', 'us-east-2')
db      = EC2('i-0987654321fedcba0', 'us-east-2')

# Use same functions on all
jenkins.stop()    # i-09519fa48c7c66f84 stopped ✅
web.start()       # i-0123456789abcdef0 started ✅
db.status()       # i-0987654321fedcba0 is running ✅
