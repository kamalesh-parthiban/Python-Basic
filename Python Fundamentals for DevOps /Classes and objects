5. Class Variables vs Instance Variables

class Server:
    # Class variable - SAME for all objects
    company     = 'MyCompany'
    total       = 0

    def __init__(self, name, ip):
        # Instance variable - DIFFERENT for each object
        self.name   = name
        self.ip     = ip
        Server.total += 1   # Increment class variable

web1 = Server('web1', '192.168.1.1')
web2 = Server('web2', '192.168.1.2')
web3 = Server('web3', '192.168.1.3')

# Class variable - same for all
print(web1.company)     # MyCompany
print(web2.company)     # MyCompany

# Instance variable - different for each
print(web1.name)        # web1
print(web2.name)        # web2

# Class variable - shared count
print(Server.total)     # 3
