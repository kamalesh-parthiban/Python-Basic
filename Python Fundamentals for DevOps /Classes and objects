    '/var/log/app.log',
    'my-bucket',
    'logs/app.log'
)

✅ Deployment Pipeline Class

import datetime
import subprocess

class DeploymentPipeline:
    def __init__(self, app_name, environment):
        self.app_name   = app_name
        self.environment = environment
        self.start_time = None
        self.end_time   = None
        self.steps      = []
        self.success    = False

    def log_step(self, step, status):
        self.steps.append({
            'step':   step,
            'status': status,
            'time':   str(datetime.datetime.now())
        })
        icon = "✅" if status == 'success' else "❌"
        print(f"{icon} {step}")

    def run_command(self, cmd, step_name):
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            self.log_step(step_name, 'success')
            return True
        else:
            self.log_step(step_name, 'failed')
            print(f"Error: {result.stderr}")
            return False

    def pull_code(self):
        return self.run_command(
            ['git', 'pull', 'origin', 'main'],
            'Pull latest code'
        )

    def run_tests(self):
        return self.run_command(
            ['python', '-m', 'pytest'],
            'Run tests'
        )

    def build_docker(self):
        return self.run_command(
            ['docker', 'build', '-t',
             f'{self.app_name}:latest', '.'],
            'Build Docker image'
        )

    def deploy(self):
        return self.run_command(
            ['kubectl', 'apply', '-f',
             'deployment.yaml'],
            'Deploy to Kubernetes'
        )

    def run_pipeline(self):
        self.start_time = datetime.datetime.now()
        print(f"\n🚀 Starting {self.app_name} "
              f"deployment to {self.environment}")
        print("=" * 50)

        # Run all steps
        if not self.pull_code():    return self.finish(False)
        if not self.run_tests():    return self.finish(False)
        if not self.build_docker(): return self.finish(False)
        if not self.deploy():       return self.finish(False)

        return self.finish(True)

    def finish(self, success):
        self.end_time   = datetime.datetime.now()
        self.success    = success
        duration        = (
            self.end_time - self.start_time
        ).seconds

        print("=" * 50)
        if success:
            print(f"✅ Deployment successful! ({duration}s)")
        else:
            print(f"❌ Deployment failed! ({duration}s)")

        print(f"\nSteps completed: {len(self.steps)}")
        return success

# Use class
pipeline = DeploymentPipeline(
    app_name='myapp',
    environment='production'
)
pipeline.run_pipeline()
