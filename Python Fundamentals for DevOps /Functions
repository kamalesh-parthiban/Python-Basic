def get_server_status(server):
    # Check server
    result = subprocess.run(
        ['ping', '-c', '1', server],
        capture_output=True
    )

    if result.returncode == 0:
        return 'running'    # Send back 'running'
    else:
        return 'down'       # Send back 'down'

