Real DevOps Use of Tuple

# 1. Fixed server configs (never changes)
DB_CONFIG = ('localhost', 5432, 'mydb', 'admin')
db_host, db_port, db_name, db_user = DB_CONFIG

# 2. Fixed environments (never add new ones)
VALID_ENVIRONMENTS = ('production', 'staging', 'development')

import sys
env = sys.argv[1]

if env not in VALID_ENVIRONMENTS:
    print(f"Invalid env! Choose from {VALID_ENVIRONMENTS}")
    sys.exit(1)

# 3. Fixed port mappings
PORT_MAPPINGS = (
    ('http',  80),
    ('https', 443),
    ('ssh',   22),
    ('mysql', 3306)
)

for service, port in PORT_MAPPINGS:
    print(f"{service} runs on port {port}")

# 4. Return multiple values from function
def get_server_info():
    return ('192.168.1.1', 8080, 'ubuntu')  # Returns tuple

ip, port, user = get_server_info()
print(ip, port, user)
