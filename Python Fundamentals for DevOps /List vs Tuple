List with Different Data Types

# List can hold any data type

# Strings
environments = ['production', 'staging', 'development']

# Numbers
ports = [80, 443, 8080, 9090]

# Mixed
mixed = ['myapp', 8080, True, 3.14]

# List of lists (nested)
servers = [
    ['web1', '192.168.1.1', 80],
    ['web2', '192.168.1.2', 80],
    ['web3', '192.168.1.3', 80]
]

# Access nested
print(servers[0][0])    # web1
print(servers[0][1])    # 192.168.1.1
print(servers[1][0])    # web2
------------------------------------------------------------------------------------------------
List Slicing

servers = ['web1', 'web2', 'web3', 'web4', 'web5']

# Get portion of list
print(servers[0:3])     # ['web1', 'web2', 'web3']
print(servers[1:4])     # ['web2', 'web3', 'web4']
print(servers[:3])      # ['web1', 'web2', 'web3'] first 3
print(servers[2:])      # ['web3', 'web4', 'web5'] from 3rd
print(servers[-2:])     # ['web4', 'web5'] last 2
