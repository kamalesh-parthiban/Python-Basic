Real DevOps Use of List

import subprocess
import paramiko

# 1. List of servers to deploy to
servers = ['192.168.1.1', '192.168.1.2', '192.168.1.3']

for server in servers:
    print(f"Deploying to {server}...")
    ssh = paramiko.SSHClient()
    ssh.connect(server, username='ubuntu', password='pass')
    ssh.exec_command('sudo systemctl restart myapp')
    ssh.close()

# 2. List of commands to run
commands = [
    'sudo apt update',
    'sudo apt install -y nginx',
    'sudo systemctl start nginx'
]

for cmd in commands:
    subprocess.run(cmd, shell=True)

# 3. List of files to backup
log_files = [
    '/var/log/app.log',
    '/var/log/nginx.log',
    '/var/log/error.log'
]

for file in log_files:
    subprocess.run(['cp', file, '/backup/'])

# 4. List of ports to check
ports = [80, 443, 8080, 5432]
for port in ports:
    print(f"Checking port {port}...")
