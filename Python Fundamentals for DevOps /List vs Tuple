Tuple with Different Data Types

# Server config as tuple (fixed - never changes)
server_config = ('192.168.1.1', 8080, 'ubuntu')

# Access
ip      = server_config[0]   # 192.168.1.1
port    = server_config[1]   # 8080
user    = server_config[2]   # ubuntu

# Unpack tuple (very useful!)
ip, port, user = server_config
print(ip)    # 192.168.1.1
print(port)  # 8080
print(user)  # ubuntu

# Nested tuple
servers = (
    ('web1', '192.168.1.1', 80),
    ('web2', '192.168.1.2', 80),
    ('web3', '192.168.1.3', 80)
)
print(servers[0][0])    # web1
print(servers[0][1])    # 192.168.1.1
