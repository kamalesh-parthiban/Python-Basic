💡 Where You Already Used Them!

# subprocess - list is used here!
subprocess.run(['git', 'pull', 'origin', 'main'])
#              ↑ This is a LIST!

# kubernetes - list comes back from API!
pods = v1.list_namespaced_pod(namespace='default')
for pod in pods.items:   # pods.items is a LIST!
    print(pod.metadata.name)

# docker - list comes back!
containers = client.containers.list()  # Returns LIST!
for c in containers:
    print(c.name)

# boto3 - list used everywhere!
response = s3.list_buckets()
for bucket in response['Buckets']:  # Buckets is a LIST!
    print(bucket['Name'])

# paramiko - list of commands!
commands = [                         # This is a LIST!
    'sudo apt update',
    'sudo apt install nginx',
    'sudo systemctl start nginx'
]
for cmd in commands:
    ssh.exec_command(cmd)

