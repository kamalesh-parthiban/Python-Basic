8. SNS – Notifications & Alerts

sns = boto3.client('sns')

# Create topic
response = sns.create_topic(Name='alerts')
topic_arn = response['TopicArn']

# Subscribe email
sns.subscribe(
    TopicArn=topic_arn,
    Protocol='email',
    Endpoint='admin@example.com'
)

# Send notification
sns.publish(
    TopicArn=topic_arn,
    Message='Server is down!',
    Subject='ALERT: Server Issue'
)

# Send SMS
sns.publish(
    PhoneNumber='+1234567890',
    Message='Deployment successful!'
)
