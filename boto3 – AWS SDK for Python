9. SQS – Message Queue

sqs = boto3.client('sqs')

# Create queue
sqs.create_queue(QueueName='myqueue')

# Send message
sqs.send_message(
    QueueUrl='https://sqs.us-east-1.amazonaws.com/123/myqueue',
    MessageBody='Deploy job started'
)

# Receive message
response = sqs.receive_message(
    QueueUrl='https://sqs.us-east-1.amazonaws.com/123/myqueue'
)
for msg in response['Messages']:
    print(msg['Body'])

# Delete message
sqs.delete_message(
    QueueUrl='https://sqs.us-east-1.amazonaws.com/123/myqueue',
    ReceiptHandle=msg['ReceiptHandle']
)
