3. EC2 – Virtual Machines

ec2 = boto3.client('ec2')

# Launch new instance
ec2.run_instances(
    ImageId='ami-12345678',
    InstanceType='t2.micro',
    MinCount=1,
    MaxCount=1
)

# List all instances
response = ec2.describe_instances()
for reservation in response['Reservations']:
    for instance in reservation['Instances']:
        print(instance['InstanceId'], instance['State']['Name'])

# Stop instance
ec2.stop_instances(InstanceIds=['i-1234567890'])

# Start instance
ec2.start_instances(InstanceIds=['i-1234567890'])

# Terminate instance
ec2.terminate_instances(InstanceIds=['i-1234567890'])

# Reboot instance
ec2.reboot_instances(InstanceIds=['i-1234567890'])

# Get instance status
ec2.describe_instance_status(InstanceIds=['i-1234567890'])

Real DevOps Use:

# Auto stop all instances at night to save cost!
ec2 = boto3.client('ec2')

response = ec2.describe_instances(
    Filters=[{'Name': 'instance-state-name', 'Values': ['running']}]
)

for reservation in response['Reservations']:
    for instance in reservation['Instances']:
        ec2.stop_instances(InstanceIds=[instance['InstanceId']])
        print(f"Stopped: {instance['InstanceId']}")

print("All instances stopped! 💰 Cost saved!")
