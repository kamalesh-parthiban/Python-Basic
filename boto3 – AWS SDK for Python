2. S3 – File Storage

s3 = boto3.client('s3')

# Create bucket
s3.create_bucket(Bucket='mybucket')

# Upload file
s3.upload_file('local_file.txt', 'mybucket', 'remote_file.txt')

# Download file
s3.download_file('mybucket', 'remote_file.txt', 'local_file.txt')

# List all buckets
response = s3.list_buckets()
for bucket in response['Buckets']:
    print(bucket['Name'])

# List files in bucket
response = s3.list_objects(Bucket='mybucket')
for obj in response['Contents']:
    print(obj['Key'])

# Delete file
s3.delete_object(Bucket='mybucket', Key='file.txt')

# Delete bucket
s3.delete_bucket(Bucket='mybucket')

# Make file public
s3.put_object_acl(
    Bucket='mybucket',
    Key='file.txt',
    ACL='public-read'
)

Real DevOps Use:

# Backup logs to S3
import boto3, os

s3 = boto3.client('s3')

for file in os.listdir('/var/log'):
    s3.upload_file(
        f'/var/log/{file}',
        'my-backup-bucket',
        f'logs/{file}'
    )
print("Logs backed up to S3! ✅")
