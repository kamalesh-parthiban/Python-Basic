6. IAM – Users & Permissions

iam = boto3.client('iam')

# Create user
iam.create_user(UserName='john')

# List users
response = iam.list_users()
for user in response['Users']:
    print(user['UserName'])

# Create access keys for user
response = iam.create_access_key(UserName='john')
print(response['AccessKey']['AccessKeyId'])
print(response['AccessKey']['SecretAccessKey'])

# Attach policy to user
iam.attach_user_policy(
    UserName='john',
    PolicyArn='arn:aws:iam::aws:policy/AmazonS3FullAccess'
)

# Create group
iam.create_group(GroupName='developers')

# Add user to group
iam.add_user_to_group(GroupName='developers', UserName='john')

# Delete user
iam.delete_user(UserName='john')
