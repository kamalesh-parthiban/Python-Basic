10. ECS – Container Service

ecs = boto3.client('ecs')

# List clusters
response = ecs.list_clusters()
print(response['clusterArns'])

# List tasks
response = ecs.list_tasks(cluster='mycluster')
print(response['taskArns'])

# Run task
ecs.run_task(
    cluster='mycluster',
    taskDefinition='mytask',
    count=1
)

# Stop task
ecs.stop_task(
    cluster='mycluster',
    task='task-id'
)

# Update service (deploy new version)
ecs.update_service(
    cluster='mycluster',
    service='myservice',
    forceNewDeployment=True
)

