7. Real DevOps Use Cases
✅ Read Kubernetes Deployment File

import yaml

# Read k8s deployment yaml
with open('deployment.yaml', 'r') as f:
    k8s = yaml.safe_load(f)

# Get current image
image = k8s['spec']['template']['spec']['containers'][0]['image']
print(f"Current image: {image}")

# Update image version
k8s['spec']['template']['spec']['containers'][0]['image'] = 'myapp:v2.0'

# Save updated yaml
with open('deployment.yaml', 'w') as f:
    yaml.dump(k8s, f, default_flow_style=False)

print("Image updated! ✅")

✅ Read Docker Compose File

import yaml

with open('docker-compose.yaml', 'r') as f:
    compose = yaml.safe_load(f)

# List all services
for service in compose['services']:
    print(f"Service: {service}")
    print(f"Image: {compose['services'][service]['image']}")

# Output:
# Service: web
# Image: nginx:latest
# Service: db
# Image: postgres:13

✅ Generate Kubernetes YAML Automatically

import yaml

# Create k8s deployment from Python
deployment = {
    'apiVersion': 'apps/v1',
    'kind': 'Deployment',
    'metadata': {
        'name': 'myapp',
        'namespace': 'default'
    },
    'spec': {
        'replicas': 3,
        'selector': {
            'matchLabels': {'app': 'myapp'}
        },
        'template': {
            'spec': {
                'containers': [{
                    'name': 'myapp',
                    'image': 'myapp:latest',
                    'ports': [{'containerPort': 8080}]
                }]
            }
        }
    }
}

# Save as yaml file
with open('deployment.yaml', 'w') as f:
    yaml.dump(deployment, f, default_flow_style=False)

print("deployment.yaml created! ✅")

✅ Read CI/CD Pipeline Config

import yaml

# Read GitHub Actions workflow
with open('.github/workflows/ci.yaml', 'r') as f:
    pipeline = yaml.safe_load(f)

# Get all jobs
for job in pipeline['jobs']:
    print(f"Job: {job}")

# Get triggers
print(pipeline['on'])  # push, pull_request etc

✅ Update Config Based on Environment

import yaml
import sys

env = sys.argv[1]  # production or staging

# Read base config
with open('config.yaml', 'r') as f:
    config = yaml.safe_load(f)

# Update based on environment
if env == 'production':
    config['replicas'] = 5
    config['database']['host'] = 'prod-db.example.com'
    config['debug'] = False
elif env == 'staging':
    config['replicas'] = 2
    config['database']['host'] = 'staging-db.example.com'
    config['debug'] = True

# Save updated config
with open(f'config.{env}.yaml', 'w') as f:
    yaml.dump(config, f, default_flow_style=False)

print(f"Config for {env} created! ✅")
