------------------------------------------------------------------------------------------------------------------------------------
2. Read YAML File

import yaml

# Read a yaml file
with open('config.yaml', 'r') as file:
    data = yaml.safe_load(file)

print(data)
# Output: {'name': 'myapp', 'version': 1.0, 'port': 8080}

# Access values
print(data['name'])          # myapp
print(data['port'])          # 8080
print(data['database']['host'])  # localhost
------------------------------------------------------------------------------------------------------------------------------------
3. Write YAML File

import yaml

# Python dictionary
data = {
    'name': 'myapp',
    'version': '1.0',
    'environment': 'production',
    'port': 8080,
    'database': {
        'host': 'localhost',
        'port': 5432,
        'name': 'mydb'
    }
}

# Write to yaml file
with open('config.yaml', 'w') as file:
    yaml.dump(data, file, default_flow_style=False)

print("YAML file created! ✅")

Output config.yaml:

database:
  host: localhost
  name: mydb
  port: 5432
environment: production
name: myapp
port: 8080
version: '1.0'
------------------------------------------------------------------------------------------------------------------------------------
4. Convert YAML to Python (Parse)

import yaml

# YAML string to Python dictionary
yaml_string = """
name: myapp
replicas: 3
image: nginx:latest
ports:
  - 80
  - 443
"""

data = yaml.safe_load(yaml_string)

print(data['name'])      # myapp
print(data['replicas'])  # 3
print(data['ports'])     # [80, 443]
------------------------------------------------------------------------------------------------------------------------------------
5. Convert Python to YAML (Dump)

import yaml

data = {
    'name': 'myapp',
    'replicas': 3,
    'image': 'nginx:latest',
    'ports': [80, 443]
}

# Convert to YAML string
yaml_string = yaml.dump(data, default_flow_style=False)
print(yaml_string)

# Output:
# image: nginx:latest
# name: myapp
# ports:
# - 80
# - 443
# replicas: 3
------------------------------------------------------------------------------------------------------------------------------------
6. Read Multiple YAML Documents

import yaml

# File with multiple documents separated by ---
yaml_content = """
---
name: service1
port: 8080
---
name: service2
port: 9090
---
name: service3
port: 7070
"""

# Load all documents
docs = list(yaml.safe_load_all(yaml_content))

for doc in docs:
    print(doc['name'], doc['port'])

# Output:
# service1 8080
# service2 9090
# service3 7070
