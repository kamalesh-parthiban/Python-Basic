13. Real DevOps Use Cases
✅ Rolling Deployment – Update Image

from kubernetes import client, config

config.load_kube_config()
apps_v1 = client.AppsV1Api()

# Get current deployment
deployment = apps_v1.read_namespaced_deployment(
    name='myapp',
    namespace='default'
)

# Update image to new version
deployment.spec.template.spec.containers[0].image = 'myapp:v2.0'

# Apply update
apps_v1.patch_namespaced_deployment(
    name='myapp',
    namespace='default',
    body=deployment
)
print("Image updated to v2.0! ✅")

✅ Auto Scale Based on Time

from kubernetes import client, config
import datetime

config.load_kube_config()
apps_v1 = client.AppsV1Api()

# Get current hour
hour = datetime.datetime.now().hour

# Scale up during business hours
if 9 <= hour <= 18:
    replicas = 10
else:
    replicas = 2

# Apply scaling
deployment = apps_v1.read_namespaced_deployment(
    name='myapp',
    namespace='default'
)
deployment.spec.replicas = replicas

apps_v1.patch_namespaced_deployment(
    name='myapp',
    namespace='default',
    body=deployment
)
print(f"Scaled to {replicas} replicas! ✅")

✅ Check All Failed Pods

from kubernetes import client, config

config.load_kube_config()
v1 = client.CoreV1Api()

# Find all failed pods
pods = v1.list_pod_for_all_namespaces()

failed_pods = []
for pod in pods.items:
    if pod.status.phase == 'Failed':
        failed_pods.append({
            'name': pod.metadata.name,
            'namespace': pod.metadata.namespace,
            'reason': pod.status.reason
        })

if failed_pods:
    print("Failed Pods Found!")
    for pod in failed_pods:
        print(f"Pod: {pod['name']}")
        print(f"Namespace: {pod['namespace']}")
        print(f"Reason: {pod['reason']}")
else:
    print("No failed pods! ✅")

✅ Cleanup Old Completed Jobs

from kubernetes import client, config

config.load_kube_config()
batch_v1 = client.BatchV1Api()

# List all jobs
jobs = batch_v1.list_namespaced_job(namespace='default')

for job in jobs.items:
    # Delete completed jobs
    if job.status.completion_time:
        batch_v1.delete_namespaced_job(
            name=job.metadata.name,
            namespace='default'
        )
        print(f"Deleted completed job: {job.metadata.name}")

print("Cleanup done! ✅")
