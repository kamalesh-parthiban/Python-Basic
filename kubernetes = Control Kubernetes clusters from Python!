10. Nodes – Cluster Machines

from kubernetes import client, config

config.load_kube_config()
v1 = client.CoreV1Api()

# List all nodes
nodes = v1.list_node()
for node in nodes.items:
    print(f"Node: {node.metadata.name}")
    print(f"Status: {node.status.conditions[-1].type}")
    print(f"CPU: {node.status.capacity['cpu']}")
    print(f"Memory: {node.status.capacity['memory']}")

# Get specific node
node = v1.read_node(name='mynode')
print(node.status.conditions)

# Cordon node (stop scheduling pods)
node.spec.unschedulable = True
v1.patch_node(name='mynode', body=node)
print("Node cordoned! ✅")

# Uncordon node
node.spec.unschedulable = False
v1.patch_node(name='mynode', body=node)
print("Node uncordoned! ✅")
