11. Real DevOps Use Cases
✅ Full Deploy Script

import docker

client = docker.from_env()

# Step 1 - Pull latest image
print("Pulling latest image...")
client.images.pull('myrepo/myapp:latest')

# Step 2 - Stop old container
try:
    old = client.containers.get('myapp')
    print("Stopping old container...")
    old.stop()
    old.remove()
except:
    print("No old container found")

# Step 3 - Run new container
print("Starting new container...")
client.containers.run(
    'myrepo/myapp:latest',
    name='myapp',
    detach=True,
    ports={'8080/tcp': 8080},
    environment={
        'DB_HOST': 'localhost',
        'DB_PASSWORD': 'secret'
    },
    restart_policy={'Name': 'always'}
)

print("Deployment Done! ✅")

