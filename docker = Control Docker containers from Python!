✅ Auto Cleanup Old Containers & Images

import docker

client = docker.from_env()

# Remove stopped containers
containers = client.containers.list(all=True)
for container in containers:
    if container.status == 'exited':
        container.remove()
        print(f"Removed container: {container.name}")

# Remove unused images
images = client.images.list()
for image in images:
    if not image.tags:
        client.images.remove(image.id)
        print(f"Removed image: {image.id}")

print("Cleanup done! ✅")

✅ Build & Push to AWS ECR

import docker
import boto3
import base64

# Get ECR login token
ecr = boto3.client('ecr', region_name='us-east-1')
token = ecr.get_authorization_token()

# Decode credentials
credentials = base64.b64decode(
    token['authorizationData'][0]['authorizationToken']
).decode('utf-8')
username, password = credentials.split(':')
registry = token['authorizationData'][0]['proxyEndpoint']

# Login to ECR
client = docker.from_env()
client.login(username=username, password=password, registry=registry)

# Build image
client.images.build(path='.', tag=f'{registry}/myapp:latest')

# Push to ECR
client.images.push(f'{registry}/myapp:latest')

print("Image pushed to AWS ECR! ✅")
