2. Connect to Docker

import docker

# Connect to Docker
client = docker.from_env()
print("Connected to Docker! ✅")

# Connect to remote Docker
client = docker.DockerClient(base_url='tcp://192.168.1.1:2375')
---------------------------------------------------------------------------------------------------------------------------------------------
3. Image Tasks

# Build image
client.images.build(path='.', tag='myapp:latest')

# Pull image from DockerHub
client.images.pull('nginx:latest')

# List all images
images = client.images.list()
for image in images:
    print(image.tags)

# Remove image
client.images.remove('myapp:latest')

# Push image to registry
client.images.push('myrepo/myapp:latest')

# Search image on DockerHub
results = client.images.search('nginx')
for result in results:
    print(result['name'])

# Tag image
image = client.images.get('myapp:latest')
image.tag('myrepo/myapp', tag='v1.0')

Real DevOps Use:

# Build and push to registry
client.images.build(path='.', tag='myrepo/myapp:latest')
client.images.push('myrepo/myapp:latest')
print("Image pushed to registry! ✅")
---------------------------------------------------------------------------------------------------------------------------------------------
4. Container Tasks

# Run a container
client.containers.run(
    'nginx',
    detach=True,
    ports={'80/tcp': 80}
)

# Run with environment variables
client.containers.run(
    'myapp:latest',
    detach=True,
    environment={
        'DB_HOST': 'localhost',
        'DB_PASSWORD': 'secret'
    }
)

# Run with volume
client.containers.run(
    'nginx',
    detach=True,
    volumes={'/host/path': {'bind': '/container/path', 'mode': 'rw'}}
)

# List running containers
containers = client.containers.list()
for c in containers:
    print(c.name, c.status)

# List ALL containers (including stopped)
containers = client.containers.list(all=True)

# Get specific container
container = client.containers.get('mycontainer')

# Stop container
container.stop()

# Start container
container.start()

# Restart container
container.restart()

# Remove container
container.remove()

# Pause container
container.pause()

# Unpause container
container.unpause()

# Rename container
container.rename('newname')
---------------------------------------------------------------------------------------------------------------------------------------------
5. Container Logs

container = client.containers.get('mycontainer')

# Get all logs
logs = container.logs(stream=False, text=True)
print(logs)

# Get last 100 lines
logs = container.logs(tail=100, text=True)
print(logs)

# Stream live logs
for log in container.logs(stream=True):
    print(log.decode('utf-8'))

# Get logs with timestamps
logs = container.logs(timestamps=True, text=True)
print(logs)
---------------------------------------------------------------------------------------------------------------------------------------------
6. Container Stats & Info

container = client.containers.get('mycontainer')

# Get container stats (CPU, Memory)
stats = container.stats(stream=False)

# CPU usage
print(stats['cpu_stats'])

# Memory usage
print(stats['memory_stats']['usage'])

# Network stats
print(stats['networks'])

# Get container details
info = container.attrs
print(info['State'])             # Running/Stopped
print(info['NetworkSettings'])   # IP, Ports
print(info['Mounts'])            # Volumes
print(info['Config']['Env'])     # Environment variables
---------------------------------------------------------------------------------------------------------------------------------------------
7. Execute Commands Inside Container

container = client.containers.get('mycontainer')

# Run command inside container
exit_code, output = container.exec_run('ls -la')
print(output.decode('utf-8'))

# Run database migration
exit_code, output = container.exec_run(
    'python manage.py migrate'
)
print(output.decode('utf-8'))

# Run with environment variables
exit_code, output = container.exec_run(
    'printenv',
    environment={'MY_VAR': 'myvalue'}
)

# Check exit code
if exit_code == 0:
    print("Command successful! ✅")
else:
    print("Command failed! ❌")
