4. Log to File

import logging

# Save logs to file
logging.basicConfig(
    level=logging.DEBUG,
    format='%(asctime)s - %(levelname)s - %(message)s',
    filename='app.log',        # Save to file
    filemode='a'               # 'a' = append, 'w' = overwrite
