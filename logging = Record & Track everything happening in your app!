12. Real DevOps Use Cases
✅ Deployment Logger

import logging
import sys
from logging.handlers import RotatingFileHandler

# Setup deployment logger
logger = logging.getLogger('deployment')
logger.setLevel(logging.DEBUG)

# Save to file
file_handler = RotatingFileHandler(
    'deployment.log',
    maxBytes=10*1024*1024,
    backupCount=5
)

# Show on screen
console_handler = logging.StreamHandler(sys.stdout)

formatter = logging.Formatter(
    '%(asctime)s - %(levelname)s - %(message)s'
)
file_handler.setFormatter(formatter)
console_handler.setFormatter(formatter)

logger.addHandler(file_handler)
logger.addHandler(console_handler)

# Use in deployment
def deploy(environment):
    logger.info(f"Starting deployment to {environment}")

    try:
        logger.debug("Pulling latest code...")
        # git pull

        logger.debug("Building docker image...")
        # docker build

        logger.debug("Pushing to registry...")
        # docker push

        logger.info(f"Deployment to {environment} successful! ✅")

    except Exception as e:
        logger.error(f"Deployment failed: {e}")
        logger.exception("Full error details:")
        sys.exit(1)

deploy('production')

✅ Server Health Monitor Logger

import logging
import subprocess

logging.basicConfig(
    filename='health.log',
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger('health')

def check_server_health():
    # Check disk space
    result = subprocess.run(
        ['df', '-h', '/'],
        capture_output=True, text=True
    )
    disk_usage = result.stdout.split('\n')[1].split()[4]
    disk_percent = int(disk_usage.replace('%', ''))

    if disk_percent > 90:
        logger.critical(f"Disk usage critical: {disk_percent}%")
    elif disk_percent > 70:
        logger.warning(f"Disk usage high: {disk_percent}%")
    else:
        logger.info(f"Disk usage OK: {disk_percent}%")

    # Check memory
    result = subprocess.run(
        ['free', '-m'],
        capture_output=True, text=True
    )
    logger.info(f"Memory stats: {result.stdout}")

check_server_health()

✅ API Call Logger

import logging
import requests
import time

logger = logging.getLogger('api')
logging.basicConfig(level=logging.DEBUG)

def call_api(url):
    logger.info(f"Calling API: {url}")
    start = time.time()

    try:
        response = requests.get(url, timeout=10)
        duration = time.time() - start

        logger.info(
            f"API Response: {response.status_code} "
            f"in {duration:.2f}s"
        )

        if response.status_code != 200:
            logger.warning(
                f"Unexpected status: {response.status_code}"
            )

        return response

    except requests.exceptions.Timeout:
        logger.error(f"API timeout: {url}")

    except requests.exceptions.ConnectionError:
        logger.critical(f"Cannot connect to: {url}")

call_api('https://api.example.com/health')
