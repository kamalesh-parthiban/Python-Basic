6. Format Options

import logging

logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(filename)s - %(lineno)d - %(message)s',
    level=logging.DEBUG
)

# Format variables:
# %(asctime)s    → timestamp
# %(name)s       → logger name
# %(levelname)s  → DEBUG, INFO, WARNING etc
# %(filename)s   → which file logged it
# %(lineno)d     → which line number
# %(funcName)s   → which function
# %(message)s    → actual log message
# %(process)d    → process ID
# %(thread)d     → thread ID
