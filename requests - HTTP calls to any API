12. Real DevOps Use Cases

import requests

# 1. Trigger Jenkins build
response = requests.post(
    'https://jenkins.example.com/job/myapp/build',
    auth=('admin', 'password')
)
print("Jenkins build triggered!")

# 2. Send Slack notification
requests.post(
    'https://hooks.slack.com/services/xxx/yyy/zzz',
    json={'text': '🚀 Deployment successful!'}
)

# 3. Call GitHub API - create issue
headers = {'Authorization': 'token mytoken'}
requests.post(
    'https://api.github.com/repos/user/repo/issues',
    headers=headers,
    json={
        'title': 'Bug found in production',
        'body': 'Details here...'
    }
)

# 4. Check website health
response = requests.get('https://myapp.com/health')
if response.status_code != 200:
    print("ALERT: Website is down!")

# 5. Call Kubernetes API
response = requests.get(
    'https://k8s-cluster/api/v1/pods',
    headers={'Authorization': f'Bearer {k8s_token}'},
    verify=False
)
print(response.json())
