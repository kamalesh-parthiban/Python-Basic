8. Real DevOps Use Cases
✅ Read AWS Policy JSON File

import json

# Read AWS IAM policy
with open('policy.json', 'r') as f:
    policy = json.load(f)

# Get all allowed actions
for statement in policy['Statement']:
    print(f"Effect: {statement['Effect']}")
    print(f"Actions: {statement['Action']}")
    print(f"Resource: {statement['Resource']}")

✅ Parse API Response

import requests
import json

# Call an API
response = requests.get('https://api.github.com/users/torvalds')

# Parse JSON response
data = response.json()

print(f"Name: {data['name']}")
print(f"Location: {data['location']}")
print(f"Public Repos: {data['public_repos']}")

✅ Read Terraform State File

import json

# Read terraform.tfstate
with open('terraform.tfstate', 'r') as f:
    state = json.load(f)

# Get all resources
for resource in state['resources']:
    print(f"Resource: {resource['type']}")
    print(f"Name: {resource['name']}")

✅ Parse AWS CLI Output

import subprocess
import json

# Run AWS CLI and capture output
result = subprocess.run(
    ['aws', 'ec2', 'describe-instances'],
    capture_output=True,
    text=True
)

# Parse JSON output
instances = json.loads(result.stdout)

# Get all instance IDs
for reservation in instances['Reservations']:
    for instance in reservation['Instances']:
        print(f"Instance: {instance['InstanceId']}")
        print(f"State: {instance['State']['Name']}")

✅ Create AWS Policy Automatically

import json

# Create IAM policy from Python
policy = {
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::mybucket/*"
        }
    ]
}

# Save as JSON file
with open('s3_policy.json', 'w') as f:
    json.dump(policy, f, indent=4)

print("AWS Policy created! ✅")

✅ Structured Logging in JSON

import json
import datetime

# Write logs in JSON format
log_entry = {
    'timestamp': str(datetime.datetime.now()),
    'level': 'ERROR',
    'service': 'myapp',
    'message': 'Database connection failed',
    'details': {
        'host': 'localhost',
        'port': 5432,
        'error': 'Connection refused'
    }
}

# Append to log file
with open('app.log', 'a') as f:
    f.write(json.dumps(log_entry) + '\n')

print("Log written! ✅")

✅ Config Management Per Environment

import json
import sys

env = sys.argv[1]  # production or staging

# Read base config
with open('config.json', 'r') as f:
    config = json.load(f)

# Update per environment
if env == 'production':
    config['debug'] = False
    config['replicas'] = 5
    config['database']['host'] = 'prod-db.example.com'
elif env == 'staging':
    config['debug'] = True
    config['replicas'] = 2
    config['database']['host'] = 'staging-db.example.com'

# Save environment config
with open(f'config.{env}.json', 'w') as f:
    json.dump(config, f, indent=4)

print(f"Config for {env} created! ✅")
