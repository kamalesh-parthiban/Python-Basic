7. JSON vs YAML Comparison

# Same data in JSON and YAML

# JSON
json_data = '''
{
    "name": "myapp",
    "replicas": 3,
    "ports": [80, 443]
}
'''

# YAML
yaml_data = '''
name: myapp
replicas: 3
ports:
  - 80
  - 443
'''

# JSON is used for → APIs, AWS, logs
# YAML is used for → K8s, Docker, CI/CD
