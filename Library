1. Basic Command Running

import subprocess

# Simple command
subprocess.run(['ls', '-la'])

# Run with shell=True (like typing in terminal)
subprocess.run('ls -la', shell=True)

# Run and check for errors automatically
subprocess.run(['git', 'pull'], check=True)
-------------------------------------------------
2. Capturing Output

# Capture command output
result = subprocess.run(['ls', '-la'], capture_output=True, text=True)

print(result.stdout)   # Normal output
print(result.stderr)   # Error output
print(result.returncode)  # 0 = success, 1 = failed

# Example - capture disk space
result = subprocess.run(['df', '-h'], capture_output=True, text=True)
print(result.stdout)
-------------------------------------------------
