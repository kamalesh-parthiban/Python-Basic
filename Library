sys - Think of it as: "Controlling how your Python script runs" // sys controls HOW your script runs — arguments, exit codes, platform detection & output! 🚀
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1. Command Line Arguments

import sys

# script called as: python deploy.py production 8080

print(sys.argv[0])   # deploy.py      (script name)
print(sys.argv[1])   # production     (1st argument)
print(sys.argv[2])   # 8080           (2nd argument)
print(len(sys.argv)) # 3              (total arguments)

Real DevOps Use:

# python deploy.py production
environment = sys.argv[1]

if environment not in ['production', 'staging']:
    print("Invalid environment!")
    sys.exit(1)

print(f"Deploying to {environment}...")
-------------------------------------------------------------------------------------------
2. Exit Script

# Exit successfully
sys.exit(0)    # 0 = success

# Exit with error
sys.exit(1)    # 1 = failed

# Exit with message
sys.exit("Something went wrong!")

Real DevOps Use:

import os, sys

if not os.path.exists('/var/www/app'):
    print("ERROR: App folder not found!")
    sys.exit(1)   # Stop script immediately

print("Folder found, continuing...")
-------------------------------------------------------------------------------------------
3. Output – stdout & stderr

# Normal output
sys.stdout.write("Deployment started\n")

# Error output (shows in red in terminal)
sys.stderr.write("ERROR: Connection failed!\n")

# Flush output immediately (useful in pipelines)
sys.stdout.flush()

Real DevOps Use:

# Separate normal logs from error logs
sys.stdout.write("INFO: Server started\n")
sys.stderr.write("ERROR: Port already in use!\n")
-------------------------------------------------------------------------------------------
4. Python Version Check

# Get Python version
print(sys.version)
# Output: 3.11.2 (main, Mar 13 2023)

print(sys.version_info)
# Output: sys.version_info(major=3, minor=11, micro=2)

print(sys.version_info.major)  # 3
print(sys.version_info.minor)  # 11

Real DevOps Use:

# Make sure correct Python version is used
if sys.version_info.major < 3:
    print("ERROR: Python 3 required!")
    sys.exit(1)

if sys.version_info.minor < 8:
    print("ERROR: Python 3.8+ required!")
    sys.exit(1)

print("Python version OK ✅")
-------------------------------------------------------------------------------------------
5. Platform / OS Detection

print(sys.platform)
# Output:
# 'linux'   → Linux
# 'darwin'  → Mac
# 'win32'   → Windows

Real DevOps Use:

# Run different commands based on OS
if sys.platform == 'linux':
    subprocess.run(['systemctl', 'restart', 'nginx'])
elif sys.platform == 'darwin':
    subprocess.run(['brew', 'services', 'restart', 'nginx'])
elif sys.platform == 'win32':
    subprocess.run(['net', 'stop', 'nginx'])
-------------------------------------------------------------------------------------------
6. Module & Path Management

# See all module search paths
print(sys.path)

# Add custom folder to search path
sys.path.append('/home/user/mymodules')

# See all currently imported modules
print(sys.modules)

# Check if a module is imported
