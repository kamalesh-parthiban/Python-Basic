# File system
ls -la
export ENV=prod

# Run commands
bash deploy.sh

# API call
curl https://api.example.com

# AWS
aws s3 ls

# JSON parsing
jq '.name' file.json

# YAML parsing
yq '.name' config.yaml

# SSH
ssh user@server

# Copy files
scp app.jar user@server:/opt/apps/

# Docker
docker ps

# Kubernetes
kubectl get pods

# Logging
logger "Deployment started"

# CLI arguments
./script.sh -e prod

# Regex / log parsing
grep "ERROR" app.log
awk '{print $1}' file.txt

# Bash testing
bats test.sh
