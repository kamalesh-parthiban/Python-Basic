===========================================
LAMBDA CODE
===========================================
import boto3
from PIL import Image
import io

s3 = boto3.client('s3')

VERSIONS = {
    '4k':    (3840, 2160),
    '1080p': (1920, 1080),
    '720p':  (1280, 720),
    '480p':  (854,  480),
    '360p':  (640,  360),
}

def lambda_handler(event, context):

    bucket   = event['Records'][0]['s3']['bucket']['name']
    key      = event['Records'][0]['s3']['object']['key']
    filename = key.split('/')[-1]

    response = s3.get_object(Bucket=bucket, Key=key)
    original = response['Body'].read()

    s3.put_object(
        Bucket = bucket,
        Key    = f'original/{filename}',
        Body   = original
    )

    image = Image.open(io.BytesIO(original))

    for version_name, size in VERSIONS.items():
        resized = image.resize(size)
        buffer  = io.BytesIO()
        resized.save(buffer, format='JPEG')
        buffer.seek(0)
        s3.put_object(
            Bucket = bucket,
            Key    = f'{version_name}/{filename}',
            Body   = buffer
        )
        print(f'{version_name} version created successfully')

    return {'status': 'done', 'versions': list(VERSIONS.keys())}

